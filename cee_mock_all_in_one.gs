/* ---------------- friendly formatting ---------------- */
function formatSheets_(props){
  props = props || PropertiesService.getScriptProperties();
  var W = function(sh, col, w){ try{ sh.setColumnWidth(col, w); }catch(e){} };
  var wrap = function(sh, col){ try{ sh.getRange(2, col, sh.getMaxRows() - 1, 1).setWrap(true); }catch(e){} };

  /* Users: hide secrets, dropdowns, status colours */
  var u = getTab_('Users');
  try{ u.hideColumns(5); u.hideColumns(10); u.hideColumns(11); }catch(e){} /* PassHash, SessionToken, SessionExpires */
  W(u, 1, 90); W(u, 2, 150); W(u, 3, 210); W(u, 4, 120); W(u, 6, 100); W(u, 7, 110); W(u, 8, 175); W(u, 12, 240);
  listValidation_(u, 7, ['pending', 'approved', 'rejected']);
  listValidation_(u, 6, ['student', 'teacher']);
  colorRules_(u, [
    {col: 7, colors: {pending: '#fff3cd', approved: '#d1e7dd', rejected: '#f8d7da'}},
    {col: 6, colors: {teacher: '#dbe4ff'}}
  ]);

  /* Questions: dropdowns for section/topic/difficulty, readable text columns */
  var q = getTab_('Questions');
  W(q, 2, 380); W(q, 8, 110); W(q, 9, 90); W(q, 10, 300); W(q, 11, 220); W(q, 12, 100);
  wrap(q, 2); wrap(q, 10);
  listValidation_(q, 8, SECTIONS_);
  var topicCodes = [];
  Object.keys(TOPICS_).forEach(function(sec){ topicCodes = topicCodes.concat(Object.keys(TOPICS_[sec])); });
  listValidation_(q, 9, topicCodes);
  listValidation_(q, 12, DIFFICULTIES_);
  colorRules_(q, [{col: 12, colors: {easy: '#d1e7dd', medium: '#fff3cd', hard: '#f8d7da'}}]);

  /* Attempts: mode colours */
  var a = getTab_('Attempts');
  W(a, 4, 165); W(a, 5, 165); W(a, 8, 220);
  colorRules_(a, [{col: 9, colors: {practice: '#d1e7dd', model: '#fff3cd'}}]);

  /* Messages: unread highlight + readable body */
  var m = getTab_('Messages');
  W(m, 4, 420); wrap(m, 4);
  colorRules_(m, [{col: 6, colors: {false: '#f8d7da'}}]);

  /* DailyExams: live highlight + wide paper column */
  var dx = getTab_('DailyExams');
  W(dx, 2, 320); wrap(dx, 2);
  colorRules_(dx, [{col: 5, colors: {live: '#d1e7dd'}}]);

  props.setProperty('CEE_FORMAT_READY', '1');
}

function listValidation_(sh, col, values){
  try{
    var rows = Math.max(999, sh.getMaxRows() - 1);
    var rule = SpreadsheetApp.newDataValidation()
      .requireValueInList(values, true).setAllowInvalid(true).build();
    sh.getRange(2, col, rows, 1).setDataValidation(rule);
  }catch(e){}
}

/** Colour-codes whole columns by text value (one rule set per sheet). */
function colorRules_(sh, specs){
  try{
    var rules = [];
    specs.forEach(function(spec){
      var range = sh.getRange(2, spec.col, Math.max(999, sh.getMaxRows() - 1), 1);
      Object.keys(spec.colors).forEach(function(txt){
        rules.push(SpreadsheetApp.newConditionalFormatRule()
          .whenTextEqualTo(txt).setBackground(spec.colors[txt])
          .setRanges([range]).build());
      });
    });
    sh.setConditionalFormatRules(rules);
  }catch(e){}
}

/* ---------------- edit watcher (installable, optional) ---------------- */
/** Enable via the menu so manual edits to the sheet behave like the app. */
function menuToggleEditWatcher(){
  var on = false;
  try{
    var ts = ScriptApp.getProjectTriggers();
    var has = false;
    for(var i = 0; i < ts.length; i++){
      if(ts[i].getHandlerFunction() === EDIT_WATCH_HANDLER_) has = true;
    }
    if(has){
      for(var j = 0; j < ts.length; j++){
        if(ts[j].getHandlerFunction() === EDIT_WATCH_HANDLER_) ScriptApp.deleteTrigger(ts[j]);
      }
      on = false;
    } else {
      ScriptApp.newTrigger(EDIT_WATCH_HANDLER_).forSpreadsheet(SS_()).onEdit().create();
      on = true;
    }
  }catch(e){
    try{ SpreadsheetApp.getUi().alert('Could not change the edit watcher: ' + e.message); }catch(_){}
    return;
  }
  try{
    SS_().toast(on ? 'Auto-respond ON — editing a registration Status now emails the student.'
                   : 'Auto-respond OFF.', 'CEE Portal', 8);
  }catch(e){}
}

/** Fires on manual edits: emails students on Status changes, tidies typed values. */
function onSheetEdit_(e){
  try{
    if(!e || !e.range) return;
    var rng = e.range, sh = rng.getSheet();
    if(rng.getNumRows() !== 1 || rng.getNumColumns() !== 1 || rng.getRow() < 2) return;
    var col = rng.getColumn(), val = String(rng.getValue() || '').toLowerCase().trim();
    var old = e.oldValue == null ? '' : String(e.oldValue).toLowerCase().trim();

    if(sh.getName() === 'Users' && col === 7){ /* Status */
      if(val === old) return;
      var head = sh.getRange(rng.getRow(), 1, 1, 3).getValues()[0];
      var id = String(head[0]), name = String(head[1]), email = String(head[2]);
      if(val === 'approved'){
        sendMailSafe_(email, 'CEE Portal — account approved',
          'Hi ' + escHtml_(name) + ',<br><br>Good news! Your account has been approved. You can now sign in and start practising.<br><br>— CEE Mock Portal');
        try{ SS_().toast('Approved ' + name + ' — email sent.', 'CEE Portal', 6); }catch(x){}
      } else if(val === 'rejected'){
        sendMailSafe_(email, 'CEE Portal — registration not approved',
          'Hi ' + escHtml_(name) + ',<br><br>We could not approve your registration at this time. Please contact your teacher for details.<br><br>— CEE Mock Portal');
        try{ SS_().toast('Rejected ' + name + ' — email sent.', 'CEE Portal', 6); }catch(x){}
      } else if(val && ['pending', 'approved', 'rejected'].indexOf(val) < 0){
        try{ SS_().toast('Status must be pending, approved or rejected.', 'CEE Portal', 6); }catch(x){}
      }
    }

    if(sh.getName() === 'Questions'){
      if(col === 12 && val && DIFFICULTIES_.indexOf(val) < 0){
        rng.setValue('medium');
        try{ SS_().toast('Difficulty must be easy, medium or hard — reset to medium.', 'CEE Portal', 6); }catch(x){}
      }
      if(col === 8 && val){
        var mapped = legacySection_(rng.getValue());
        if(mapped !== String(rng.getValue())) rng.setValue(mapped);
      }
    }
  }catch(err){ /* never block the user's edit */ }
}

