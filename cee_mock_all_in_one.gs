/* ============================================================================
   CONFIGURATION (schema v3)
   Leave SHEET_ID empty for a container-attached script (the usual setup);
   set it only when this script is standalone and must open a sheet by ID.
   ============================================================================ */
var SHEET_ID = '';
var SECONDS_PER_QUESTION = 54;   /* MECEE-BL: 200 questions in 180 minutes   */
var MIN_EXAM_MINUTES = 10;       /* the clock never drops below this          */
var QUESTIONS_PER_EXAM = 20;     /* default size of a custom practice paper   */
var SESSION_HOURS = 24;          /* login session lifetime                    */
var MAX_QUESTIONS_RETURNED = 1000; /* safety cap for getAllQuestions          */
var EXAM_GRACE_MS = 120000;      /* late-submit grace before flagging        */
var MAX_IMAGE_CHARS = 48000;     /* inline image payload cap (~48 KB)         */
var LOGIN_MAX_FAILS = 5;         /* failed logins before the lockout          */
var LOGIN_LOCK_SECONDS = 120;    /* lockout duration                          */
var MODEL_DEFAULT_COUNT = 20;    /* questions in the model exam of the day    */
var MODEL_HISTORY_DAYS = 7;      /* days of daily-exam history to return      */
var MODEL_AUTO_HOUR = 20;        /* autopilot trigger hour (20:00 script TZ)  */

/* ============================================================================
   SHEET CORE — tabs, headers, read/write helpers, v3 self-healing migration
   ============================================================================ */
var TAB_SCHEMA_ = {
  Users:     ['ID','Name','Email','Username','PassHash','Role','Status','CreatedAt','DeviceId','SessionToken','SessionExpires','Notes'],
  Questions: ['ID','Text','OptA','OptB','OptC','OptD','Answer','Section','Topic','Explanation','Image','Difficulty','CreatedAt','UpdatedAt'],
  Attempts:  ['ID','AttemptIndex','UserId','StartedAt','SubmittedAt','DurMin','Deadline','Section','Mode','DailyDate','NegMarking','Score','Total','Correct','Wrong','Skipped','Accuracy','AutoSubmitted','Late'],
  Responses: ['ID','AttemptId','UserId','QId','QuestionText','Chosen','IsCorrect','Section','Topic'],
  Messages:  ['ID','FromUserId','FromName','Message','CreatedAt','Read'],
  DailyExams:['Date','QIds','Count','DurMin','Status','GeneratedBy','GeneratedAt']
};
var TABS_READY_KEY_ = 'CEE_TABS_READY';
var TABS_VERSION_ = 'v3';

function SS_(){
  return SHEET_ID ? SpreadsheetApp.openById(SHEET_ID) : SpreadsheetApp.getActiveSpreadsheet();
}

/** Public: quick link to the backing spreadsheet (teacher convenience). */
function getSpreadsheet(){
  ensureSheets_();
  var ss = SS_();
  return {ok:true, name:ss.getName(), url:ss.getUrl(), id:ss.getId()};
}

/** Public: (re)create + self-heal every tab. Safe to run any time. */
function initializeSheet(){
  ensureSheets_();
  var seeded = ensureSeed_() ? ' seeded 10 demo questions' : '';
  return {ok:true, message:'All tabs ready (' + TABS_VERSION_ + ').' + seeded};
}

function getTab_(name){
  var ss = SS_();
  var sh = ss.getSheetByName(name);
  if(!sh){
    sh = ss.insertSheet(name);
    sh.getRange(1, 1, 1, TAB_SCHEMA_[name].length).setValues([TAB_SCHEMA_[name]])
      .setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

/* v3 migration: create missing tabs, append missing columns to existing tabs
   and backfill the Difficulty column. Runs at most once per version bump. */
function ensureSheets_(){
  Object.keys(TAB_SCHEMA_).forEach(function(name){ getTab_(name); });
  var props = PropertiesService.getScriptProperties();
  if(String(props.getProperty(TABS_READY_KEY_)) === TABS_VERSION_) return;
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    if(String(props.getProperty(TABS_READY_KEY_)) === TABS_VERSION_) return;
    Object.keys(TAB_SCHEMA_).forEach(function(name){
      var sh = getTab_(name);
      var head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0]
        .map(function(h){ return String(h).replace(/^'/,''); });
      TAB_SCHEMA_[name].forEach(function(col){
        if(head.indexOf(col) < 0){
          sh.insertColumnAfter(sh.getLastColumn());
          var c = sh.getLastColumn();
          sh.getRange(1, c).setValue(col).setFontWeight('bold');
          if(name === 'Questions' && col === 'Difficulty' && sh.getLastRow() > 1){
            sh.getRange(2, c, sh.getLastRow() - 1, 1).setValue('medium');
          }
        }
      });
    });
    props.setProperty(TABS_READY_KEY_, TABS_VERSION_);
    /* one-time cosmetic pass: live Dashboard tab, dropdowns, colour coding */
    try{ buildDashboard_(); formatSheets_(props); }catch(e){ /* never block the portal on cosmetics */ }
  } finally {
    lock.releaseLock();
  }
}

/* Sheets re-interprets leading '=', '+', '-', apostrophes and date-like text;
   every string cell is written apostrophe-prefixed and stripped on read. */
function escCell_(v){
  if(v == null) return '';
  return "'" + String(v);
}
function stripCell_(v){
  if(v == null) return '';
  return String(v).replace(/^'/, '');
}

function readTab_(name){
  var sh = getTab_(name);
  var rng = sh.getDataRange();
  var vals = rng.getValues();
  if(vals.length < 2) return [];
  var head = vals[0].map(function(h){ return String(h).replace(/^'/,''); });
  var out = [];
  for(var r = 1; r < vals.length; r++){
    if(vals[r].join('') === '') continue;
    var o = {_row: r + 1};
    for(var c = 0; c < head.length; c++){
      var v = vals[r][c];
      o[head[c]] = (v instanceof Date) ? v.toISOString() : (typeof v === 'string' ? stripCell_(v) : v);
    }
    out.push(o);
  }
  return out;
}

function appendObj_(name, obj){
  var sh = getTab_(name);
  var head = TAB_SCHEMA_[name];
  var row = head.map(function(h){
    var v = obj[h];
    if(v == null) return '';
    return (typeof v === 'string') ? escCell_(v) : v;
  });
  sh.getRange(sh.getLastRow() + 1, 1, 1, row.length).setValues([row]);
}

function findRowById_(name, id){
  var rows = readTab_(name);
  for(var i = 0; i < rows.length; i++){
    if(String(rows[i].ID) === String(id)) return rows[i];
  }
  return null;
}

function patchRow_(name, rowNum, patch){
  var sh = getTab_(name);
  var head = TAB_SCHEMA_[name];
  var row = sh.getRange(rowNum, 1, 1, head.length).getValues()[0];
  for(var c = 0; c < head.length; c++){
    if(patch.hasOwnProperty(head[c])){
      var v = patch[head[c]];
      row[c] = (typeof v === 'string') ? escCell_(v) : (v == null ? '' : v);
    }
  }
  sh.getRange(rowNum, 1, 1, head.length).setValues([row]);
}

function deleteRowById_(name, id){
  var row = findRowById_(name, id);
  if(!row) return false;
  getTab_(name).deleteRow(row._row);
  return true;
}

/* ============================================================================
   GENERAL UTILITIES
   ============================================================================ */
function nowISO_(){ return new Date().toISOString(); }

/* ============================================================================
   ID GENERATION HELPERS - Custom formats per entity type
   ========================================================================== */
function getNextQuestionId_(section){
  var sh = getTab_('Questions');
  var lastRow = sh.getLastRow();
  if(lastRow < 2) return getInitialQuestionId_(section);
  
  var prefix = getQuestionPrefix_(section);
  var allIds = sh.getRange(2, 1, lastRow - 1, 1).getValues().map(function(r){ return String(r[0]); });
  var maxNum = 0;
  for(var i = 0; i < allIds.length; i++){
    var id = allIds[i];
    if(id.indexOf(prefix) === 0){
      var numStr = id.substring(prefix.length);
      var num = parseInt(numStr, 10);
      if(!isNaN(num) && num > maxNum) maxNum = num;
    }
  }
  return prefix + padNumber_(maxNum + 1, 4);
}

function getQuestionPrefix_(section){
  var sec = String(section || '').toUpperCase();
  if(sec.indexOf('PHYS') >= 0 || sec.indexOf('P') === 0) return 'QP-';
  if(sec.indexOf('CHEM') >= 0) return 'QC-';
  if(sec.indexOf('ZOO') >= 0 || sec.indexOf('BIOL') >= 0) return 'QZ-';
  if(sec.indexOf('BOT') >= 0) return 'QB-';
  if(sec === 'MAT' || sec.indexOf('MENTAL') >= 0 || sec.indexOf('MATH') >= 0) return 'QA-';
  if(sec.indexOf('ENG') >= 0) return 'QE-';
  return 'Q-';
}

function getNextStudentId_(){
  var sh = getTab_('Users');
  var lastRow = sh.getLastRow();
  if(lastRow < 2) return 'S-20010';
  
  var allIds = sh.getRange(2, 1, lastRow - 1, 1).getValues().map(function(r){ return String(r[0]); });
  var maxNum = 20009;
  for(var i = 0; i < allIds.length; i++){
    var id = allIds[i];
    if(id.indexOf('S-') === 0){
      var numStr = id.substring(2);
      var num = parseInt(numStr, 10);
      if(!isNaN(num) && num > maxNum) maxNum = num;
    }
  }
  return 'S-' + (maxNum + 1);
}

function getNextTeacherId_(){
  var sh = getTab_('Users');
  var lastRow = sh.getLastRow();
  if(lastRow < 2) return 'T-001';
  
  var allIds = sh.getRange(2, 1, lastRow - 1, 1).getValues().map(function(r){ return String(r[0]); });
  var maxNum = 0;
  for(var i = 0; i < allIds.length; i++){
    var id = allIds[i];
    if(id.indexOf('T-') === 0){
      var numStr = id.substring(2);
      var num = parseInt(numStr, 10);
      if(!isNaN(num) && num > maxNum) maxNum = num;
    }
  }
  return 'T-' + padNumber_(maxNum + 1, 3);
}

function getInitialQuestionId_(section){
  var prefix = getQuestionPrefix_(section);
  return prefix + '0001';
}

function padNumber_(num, digits){
  var str = String(num);
  while(str.length < digits) str = '0' + str;
  return str;
}

function uid_(){ return Utilities.getUuid(); }

function err_(msg, code){
  var e = new Error(msg);
  if(code) e.code = code;
  return e;
}

/** Public per project brief: SHA-256 password hash (hex). */
function hashPassword(pw){
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(pw), Utilities.Charset.UTF_8);
  return bytes.map(function(b){
    var h = (b < 0 ? b + 256 : b).toString(16);
    return h.length === 1 ? '0' + h : h;
  }).join('');
}

/** Public per project brief: random in-place shuffle (returns a copy). */
function shuffleArray(arr){
  var out = arr.slice();
  for(var i = out.length - 1; i > 0; i--){
    var j = Math.floor(Math.random() * (i + 1));
    var t = out[i]; out[i] = out[j]; out[j] = t;
  }
  return out;
}

function norm_(s){
  return String(s == null ? '' : s).toLowerCase().replace(/\s+/g, ' ').trim();
}

function strSeed_(str){
  var h = 2166136261;
  str = String(str || '');
  for(var i = 0; i < str.length; i++){
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function mulberry32_(a){
  return function(){
    a |= 0; a = a + 0x6D2B79F5 | 0;
    var t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}

function seededShuffle_(arr, seed){
  var out = arr.slice(), rnd = mulberry32_(seed), i, j, t;
  for(i = out.length - 1; i > 0; i--){
    j = Math.floor(rnd() * (i + 1));
    t = out[i]; out[i] = out[j]; out[j] = t;
  }
  return out;
}

/* ============================================================================
   EXAM-OPTION MATHS (1:1 with the client twins in the embedded frontend)
   ============================================================================ */
/* MECEE-BL 2026 (third revision, April 28, 2026) — Group I (MBBS/BDS/…)
   blueprint: Zoology 40 / Botany 40 / Chemistry 50 / Physics 50 / MAT 20. */
var SECTIONS_ = ['Zoology','Botany','Chemistry','Physics','MAT'];
var TOPICS_ = {
  Zoology:{Z1:'Evolutionary Biology',Z2:'Animal Diversity & Classification',Z3:'Animal Tissues & Histology',
           Z4:'Study of Selected Animals',Z5:'Human Biology & Physiology',Z6:'Microbial Diseases & Immunology',
           Z7:'Medical Technology & Applied Biology',Z8:'Biota, Environment & Conservation'},
  Botany:{B1:'Basic Components of Life',B2:'Biodiversity',B3:'Ecology & Vegetation',B4:'Cell Biology',
          B5:'Genetics',B6:'Plant Anatomy',B7:'Plant Physiology',B8:'Developmental Botany',B9:'Applied Botany'},
  Chemistry:{C1:'Physical Chemistry',C2:'Inorganic Chemistry',C3:'Organic Chemistry',C4:'Applied Chemistry',C5:'Analytical Chemistry'},
  Physics:{P1:'Mechanics',P2:'Heat & Thermodynamics',P3:'Waves & Optics',
           P4:'Current Electricity & Magnetism',P5:'Electrostatics & Capacitors',P6:'Modern Physics'},
  MAT:{A1:'Verbal Reasoning',A2:'Numerical Reasoning',A3:'Logical Sequencing',A4:'Spatial Relation / Abstract Reasoning'}
};
/* Pre-2026 banks may still carry the legacy subject names; they are remapped
   on read so old data keeps working inside the new blueprint. */
var LEGACY_SECTIONS_ = {biology:'Zoology', maths:'MAT', math:'MAT', mathematics:'MAT', mentalability:'MAT'};
function legacySection_(s){
  var k = norm_(s).replace(/[^a-z]/g, '');
  return LEGACY_SECTIONS_[k] || String(s || '');
}
var DIFFICULTIES_ = ['easy','medium','hard'];
function normalizeDifficulty_(d){
  d = String(d == null ? '' : d).toLowerCase().trim();
  return DIFFICULTIES_.indexOf(d) >= 0 ? d : 'medium';
}

function normalizeExamOptions_(o){
  o = o || {};
  var mode = (o.mode === 'practice') ? 'practice' : 'mock';
  var subs = Object.prototype.toString.call(o.subjects) === '[object Array]'
    ? o.subjects.filter(function(s){ return SECTIONS_.indexOf(s) >= 0; }) : [];
  subs = subs.filter(function(s, i){ return subs.indexOf(s) === i; }).sort();
  var tops = Object.prototype.toString.call(o.topics) === '[object Array]'
    ? o.topics.map(function(t){ return String(t || '').toUpperCase(); })
      .filter(function(t){
        return Object.keys(TOPICS_).some(function(sec){ return TOPICS_[sec][t]; });
      }) : [];
  tops = tops.filter(function(t, i){ return tops.indexOf(t) === i; }).sort();
  var count = Math.max(0, Math.min(200, parseInt(o.count, 10) || 0));
  var timed = mode === 'mock' ? true : !!o.timed;
  /* mock duration is 0 = "auto": derived from the paper the bank can actually fill */
  var dur = 0;
  if(mode !== 'mock'){
    dur = Math.max(0, Math.min(240, parseInt(o.durationMinutes, 10) || 0));
    if(timed && dur === 0) dur = 60;
  }
  var neg = mode === 'mock' ? true : !!o.negMarking;
  var ifb = mode === 'practice' ? !!o.ifb : false;
  return {mode:mode, subjects:subs, topics:tops, count:count, timed:timed, durationMinutes:dur, negMarking:neg, ifb:ifb};
}

function examOptsSignature_(o){
  return ['v1', o.mode, o.subjects.join('+'), o.topics.join('+'), o.count,
          o.timed ? 1 : 0, o.durationMinutes, o.negMarking ? 1 : 0, o.ifb ? 1 : 0].join('|');
}

function filterBankForPractice_(bank, opts){
  if(opts.mode !== 'practice') return bank;
  return bank.filter(function(q){
    if(opts.subjects.length && opts.subjects.indexOf(q.section) < 0) return false;
    if(opts.topics.length && opts.topics.indexOf(String(q.topic || '').toUpperCase()) < 0) return false;
    return true;
  });
}

/* ---------- MECEE-BL 2026 bachelor-level paper blueprint ----------
   Official pattern: 200 MCQs / 180 minutes (54 s each) / +1 / −0.25.
   Zoology 20%, Botany 20%, Chemistry 25%, Physics 25%, MAT 10%.
   Papers are difficulty-weighted ~20% easy / 60% medium / 20% hard.
   KEEP IN SYNC with the identical block in index.html — the client shows the
   paper this builds and the server rebuilds it again when scoring.            */
var CEE_BLUEPRINT_ = [
  {section:'Zoology',   n:40},
  {section:'Botany',    n:40},
  {section:'Chemistry', n:50},
  {section:'Physics',   n:50},
  {section:'MAT',       n:20}
];
var CEE_TOTAL_Q_ = 200, CEE_MAX_MINUTES_ = 240;
var CEE_DIFFICULTY_MIX_ = {easy:0.2, medium:0.6, hard:0.2};

function ceeDurationFor_(n){
  var mins = Math.round((n || 0) * SECONDS_PER_QUESTION / 60);
  return Math.max(MIN_EXAM_MINUTES, Math.min(CEE_MAX_MINUTES_, mins));
}

/* Deterministic difficulty-weighted pick: keeps the seeded pool order, takes
   ~20/60/20 easy/medium/hard where the bank allows, then tops up from
   whatever is left. 1:1 twin of pickByDifficultyClient in index.html.        */
function pickByDifficulty_(pool, n){
  if(pool.length <= n) return pool.slice();
  var byDiff = {easy:[], medium:[], hard:[]};
  pool.forEach(function(q){
    byDiff[normalizeDifficulty_(q.difficulty)].push(q);
  });
  var chosen = {};
  DIFFICULTIES_.forEach(function(d){
    var want = Math.min(byDiff[d].length, Math.round(n * CEE_DIFFICULTY_MIX_[d]));
    for(var i = 0; i < want; i++) chosen[byDiff[d][i].id] = true;
  });
  var out = pool.filter(function(q){ return chosen[q.id]; });
  if(out.length < n){
    var seen = {};
    out.forEach(function(q){ seen[q.id] = true; });
    for(var j = 0; j < pool.length && out.length < n; j++){
      if(!seen[pool[j].id]){ out.push(pool[j]); seen[pool[j].id] = true; }
    }
  }
  return out.slice(0, n);
}

function buildCeeMockSet_(bank, seed){
  var bySection = {};
  bank.forEach(function(q){
    var s = q.section;
    if(!bySection[s]) bySection[s] = [];
    bySection[s].push(q);
  });
  var takes = [], rest = [];
  CEE_BLUEPRINT_.forEach(function(b, i){
    var pool = seededShuffle_(bySection[b.section] || [], seed + i * 7919);
    var take = pickByDifficulty_(pool, b.n);
    takes.push(take);
    var taken = {};
    take.forEach(function(q){ taken[q.id] = true; });
    pool.forEach(function(q){ if(!taken[q.id]) rest.push(q); });
  });
  var picked = takes.reduce(function(n, t){ return n + t.length; }, 0);
  if(picked < CEE_TOTAL_Q_ && rest.length){
    var fill = seededShuffle_(rest, seed + 104729).slice(0, CEE_TOTAL_Q_ - picked);
    fill.forEach(function(q){
      for(var i = 0; i < CEE_BLUEPRINT_.length; i++){
        if(CEE_BLUEPRINT_[i].section === q.section){ takes[i].push(q); return; }
      }
      takes[0].push(q);
    });
  }
  var out = [];
  takes.forEach(function(t){ out = out.concat(t); });
  return out;
}

function buildExamSet_(bank, opts, seed){
  if(opts.mode === 'mock') return buildCeeMockSet_(bank, seed);
  var pool = filterBankForPractice_(bank, opts);
  var set = seededShuffle_(pool, seed);
  if(opts.count > 0) set = set.slice(0, Math.min(opts.count, set.length));
  return set;
}

function scoreItem_(q, chosen, neg){
  if(chosen == null || chosen < 0) return {state:'skipped', pts:0};
  if(parseInt(chosen, 10) === parseInt(q.answer, 10)) return {state:'correct', pts:1};
  return {state:'wrong', pts: neg ? -0.25 : 0};
}

