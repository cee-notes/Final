function getUserById_(id){
  return findRowById_('Users', id);
}
function getUserByEmail_(email){
  email = String(email || '').toLowerCase().trim();
  var rows = readTab_('Users');
  for(var i = 0; i < rows.length; i++){
    if(String(rows[i].Email).toLowerCase() === email) return rows[i];
  }
  return null;
}
function pubUser_(u){
  return {id:String(u.ID), name:String(u.Name), email:String(u.Email), username:String(u.Username),
          role:String(u.Role), status:String(u.Status), createdAt:String(u.CreatedAt),
          hasDevice:!!u.DeviceId};
}
/** Validates the session token; role (optional) must match. Throws on failure. */
function requireSession_(userId, token, role){
  var u = getUserById_(userId);
  if(!u || !u.SessionToken || String(u.SessionToken) !== String(token)) throw err_('Session expired. Please sign in again.', 'NO_SESSION');
  if(u.SessionExpires && new Date(stripCell_(u.SessionExpires)) < new Date()) throw err_('Session expired. Please sign in again.', 'NO_SESSION');
  if(role && String(u.Role) !== role) throw err_('You do not have permission to do that.', 'FORBIDDEN');
  return u;
}

function loginRateLimitOk_(email){
  var cache = CacheService.getScriptCache();
  if(cache.get('lock_' + email)) return false;
  return true;
}
function loginRateFail_(email){
  var cache = CacheService.getScriptCache();
  var n = parseInt(cache.get('rl_' + email) || '0', 10) + 1;
  if(n >= LOGIN_MAX_FAILS){ cache.put('lock_' + email, '1', LOGIN_LOCK_SECONDS); cache.remove('rl_' + email); }
  else cache.put('rl_' + email, String(n), 600);
}
function loginRateClear_(email){
  var cache = CacheService.getScriptCache();
  cache.remove('rl_' + email);
  cache.remove('lock_' + email);
}

/* ============================================================================
   PUBLIC API — AUTH
   ============================================================================ */
function registerUser(name, email, username, password){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    name = String(name || '').trim();
    email = String(email || '').toLowerCase().trim();
    username = String(username || '').toLowerCase().trim();
    if(name.length < 2) throw err_('Please enter your full name.');
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw err_('Please enter a valid email address.');
    if(username.length < 3 || !/^[a-z0-9_.]+$/.test(username)) throw err_('Username must be 3+ characters (letters, numbers, dot or underscore).');
    if(String(password || '').length < 6) throw err_('Password must be at least 6 characters.');
    if(getUserByEmail_(email)) throw err_('An account with this email already exists.');
    if(readTab_('Users').some(function(u){ return String(u.Username) === username; })) throw err_('This username is already taken.');
    var u = {ID:getNextStudentId_(), Name:name, Email:email, Username:username,
             PassHash:hashPassword(password), Role:'student', Status:'pending',
             CreatedAt:nowISO_(), DeviceId:'', SessionToken:'', SessionExpires:''};
    appendObj_('Users', u);
    emailNewRegistration_(u);
    return {ok:true, message:'Registration submitted. You can sign in once a teacher approves your account.'};
  } finally {
    lock.releaseLock();
  }
}

function loginUser(email, password, deviceId){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    email = String(email || '').toLowerCase().trim();
    if(!loginRateLimitOk_(email)){
      throw err_('Too many failed attempts. Try again in 2 minutes.', 'TOO_MANY_ATTEMPTS');
    }
    var u = getUserByEmail_(email);
    if(!u || String(u.PassHash) !== hashPassword(String(password || ''))){
      loginRateFail_(email);
      var cache = CacheService.getScriptCache();
      throw err_(cache.get('lock_' + email) ? 'Too many failed attempts. Locked for 2 minutes.' : 'Incorrect email or password.',
                 cache.get('lock_' + email) ? 'TOO_MANY_ATTEMPTS' : 'BAD_LOGIN');
    }
    loginRateClear_(email);
    if(u.Status === 'pending') throw err_('Your account is awaiting teacher approval. You will be notified by email.', 'PENDING');
    if(u.Status === 'rejected') throw err_('Your registration was not approved. Please contact your teacher.', 'REJECTED');
    if(u.DeviceId && String(u.DeviceId) !== String(deviceId || '')){
      throw err_('This account is bound to another device. Ask a teacher to reset your device.', 'DEVICE_LOCKED');
    }
    var token = uid_();
    patchRow_('Users', u._row, {DeviceId:String(deviceId || ''), SessionToken:token,
                                SessionExpires:new Date(Date.now() + SESSION_HOURS * 3600000).toISOString()});
    return {user:pubUser_(u), token:token};
  } finally {
    lock.releaseLock();
  }
}

function logoutUser(userId, token){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    var u = getUserById_(userId);
    if(u && u.SessionToken && String(u.SessionToken) === String(token || '')){
      patchRow_('Users', u._row, {SessionToken:'', SessionExpires:''});
    }
    return {ok:true};
  } finally {
    lock.releaseLock();
  }
}

function restoreSession(userId, token){
  try{
    var u = requireSession_(userId, token);
    return {ok:true, user:pubUser_(u), token:token};
  }catch(e){
    return {ok:false};
  }
}

function changePassword(userId, token, oldPw, newPw){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    var u = requireSession_(userId, token);
    if(String(u.PassHash) !== hashPassword(String(oldPw || ''))) throw err_('Current password is incorrect.');
    if(String(newPw || '').length < 6) throw err_('New password must be at least 6 characters.');
    if(String(newPw) === String(oldPw)) throw err_('New password must differ from the current one.');
    patchRow_('Users', u._row, {PassHash:hashPassword(newPw)});
    sendMailSafe_(String(u.Email), 'CEE Portal — password changed',
      'Hi ' + escHtml_(u.Name) + ',<br><br>Your account password was just changed. If this was not you, contact your teacher immediately.');
    return {ok:true, message:'Password updated. A confirmation email was sent.'};
  } finally {
    lock.releaseLock();
  }
}

function approve(userId, token, targetId){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    requireSession_(userId, token, 'teacher');
    var u = getUserById_(targetId);
    if(!u) throw err_('User not found.');
    patchRow_('Users', u._row, {Status:'approved'});
