   ============================================================================ */
function getTeacherStats(userId, token){
  requireSession_(userId, token, 'teacher');
  var users = readTab_('Users');
  var attempts = readTab_('Attempts');
  var students = users.filter(function(u){ return String(u.Role) === 'student'; });
  var pending = users.filter(function(u){ return String(u.Status) === 'pending'; });
  var recent = attempts.slice().sort(function(a, b){ return new Date(b.SubmittedAt) - new Date(a.SubmittedAt); })
    .slice(0, 8).map(function(a){
      var u = null;
      for(var i = 0; i < users.length; i++){ if(String(users[i].ID) === String(a.UserId)){ u = users[i]; break; } }
      return {name:u ? String(u.Name) : '(deleted)', type:String(a.Mode), score:Number(a.Score),
              total:Number(a.Total), at:String(a.SubmittedAt)};
    });
  var unread = readTab_('Messages').filter(function(m){ return String(m.Read) !== 'true'; }).length;
  return {stats:{students:students.length, pending:pending.length, bank:bank_().length, attempts:attempts.length,
                 unread:unread},
    pending:pending.map(function(u){ return {id:String(u.ID), name:String(u.Name), email:String(u.Email),
      username:String(u.Username), createdAt:String(u.CreatedAt)}; }),
    users:users.map(pubUser_),
    recent:recent};
}

function getTeacherAnalytics(userId, token){
  requireSession_(userId, token, 'teacher');
  var users = readTab_('Users').filter(function(u){ return String(u.Role) === 'student' && String(u.Status) === 'approved'; });
  var attempts = readTab_('Attempts');
  var responses = readTab_('Responses');
  var rows = [], classSubj = {}, classTops = {}, totAtt = 0, totAns = 0, accSum = 0;
  users.forEach(function(u){
    var at = attempts.filter(function(a){ return String(a.UserId) === String(u.ID); });
    var rs = responses.filter(function(r){ return String(r.UserId) === String(u.ID); });
    var answered = rs.length, correct = 0, subj = {}, tops = {};
    rs.forEach(function(r){
      classSubj[r.Section] = classSubj[r.Section] || {answered:0, correct:0};
      classSubj[r.Section].answered++; totAns++;
      subj[r.Section] = subj[r.Section] || {answered:0, correct:0};
      subj[r.Section].answered++;
      tops[String(r.Topic || '—')] = tops[String(r.Topic || '—')] || {answered:0, correct:0, section:String(r.Section)};
      tops[String(r.Topic || '—')].answered++;
      var isC = String(r.IsCorrect) === 'true';
      if(isC){
        classSubj[r.Section].correct++; subj[r.Section].correct++; tops[String(r.Topic || '—')].correct++;
      }
      var tk = String(r.Topic || '—') + '|' + r.Section;
      classTops[tk] = classTops[tk] || {topic:String(r.Topic || ''), section:String(r.Section), answered:0, correct:0};
      classTops[tk].answered++;
      if(isC) classTops[tk].correct++;
      if(isC) correct++;
    });
    var weakest = null, wAcc = 2;
    Object.keys(subj).forEach(function(s){
      var acc = subj[s].correct / subj[s].answered;
      if(subj[s].answered >= 3 && acc < wAcc){ wAcc = acc; weakest = s; }
    });
    var avgAcc = answered ? Math.round(correct / answered * 1000) / 10 : 0;
    totAtt += at.length; accSum += avgAcc;
    var lastActive = '';
    at.forEach(function(a){ if(String(a.SubmittedAt) > lastActive) lastActive = String(a.SubmittedAt); });
    rows.push({userId:String(u.ID), name:String(u.Name), attempts:at.length, avgAcc:avgAcc,
      best: at.length ? Math.max.apply(null, at.map(function(a){ return Number(a.Score); })) : 0,
      answered:answered, weakest:weakest,
      weakestAcc: weakest ? Math.round(wAcc * 1000) / 10 : null,
      lastActive:lastActive});
  });
  rows.sort(function(a, b){ return b.avgAcc - a.avgAcc; });
  var subjectStats = Object.keys(classSubj).map(function(s){
    var o = classSubj[s];
    return {section:s, answered:o.answered, acc:Math.round(o.correct / o.answered * 1000) / 10};
  }).sort(function(a, b){ return b.acc - a.acc; });
  var weakTopics = Object.keys(classTops).map(function(k){ return classTops[k]; })
    .filter(function(t){ return t.answered >= 3 && t.correct / t.answered < 0.7; })
    .map(function(t){
      var code = String(t.topic || '').toUpperCase();
      return {code:code, topic:(TOPICS_[t.section] && TOPICS_[t.section][code]) || t.topic || 'General',
              section:t.section, answered:t.answered, acc:Math.round(t.correct / t.answered * 1000) / 10};
    })
    .sort(function(a, b){ return a.acc - b.acc; }).slice(0, 6);
  var active = rows.filter(function(r){ return r.attempts > 0; }).length;
  return {overview:{activeStudents:active, totalStudents:users.length,
      participation: users.length ? Math.round(active / users.length * 100) : 0,
      attempts:totAtt, avgAccuracy: rows.length ? Math.round(accSum / rows.length * 10) / 10 : 0,
      answered:totAns},
    studentRows:rows, subjectStats:subjectStats, weakTopics:weakTopics};
}

function getStudentDetail(userId, token, targetUserId){
  requireSession_(userId, token, 'teacher');
  var u = getUserById_(targetUserId);
  if(!u) throw err_('Student not found.');
  var at = readTab_('Attempts').filter(function(a){ return String(a.UserId) === String(targetUserId); })
    .sort(function(a, b){ return new Date(b.SubmittedAt) - new Date(a.SubmittedAt); });
  var agg = responsesAgg_(targetUserId);
  var answered = agg.rs.length, correct = agg.rs.filter(function(r){ return String(r.IsCorrect) === 'true'; }).length;
  var subjectStats = Object.keys(agg.subj).map(function(s){
    return {section:s, answered:agg.subj[s].answered, acc:Math.round(agg.subj[s].correct / agg.subj[s].answered * 1000) / 10};
  }).sort(function(a, b){ return b.acc - a.acc; });
  var weakTopics = Object.keys(agg.tops).map(function(k){ return agg.tops[k]; })
    .filter(function(t){ return t.answered >= 3 && t.correct / t.answered < 0.7; })
    .map(function(t){
      var code = String(t.topic || '').toUpperCase();
      return {code:code, topic:(TOPICS_[t.section] && TOPICS_[t.section][code]) || t.topic || 'General',
              section:t.section, answered:t.answered, acc:Math.round(t.correct / t.answered * 1000) / 10};
    });
  return {profile:{id:String(u.ID), name:String(u.Name), email:String(u.Email), username:String(u.Username),
                   status:String(u.Status), createdAt:String(u.CreatedAt)},
    stats:{attempts:at.length, avgAcc: answered ? Math.round(correct / answered * 1000) / 10 : 0,
           best: at.length ? Math.max.apply(null, at.map(function(a){ return Number(a.Score); })) : 0,
           answered:answered},
    subjectStats:subjectStats, weakTopics:weakTopics,
    attempts:at.slice(0, 12).map(function(a){
      return {id:String(a.ID), at:String(a.SubmittedAt), type:String(a.Mode), score:Number(a.Score),
              total:Number(a.Total), correct:Number(a.Correct), wrong:Number(a.Wrong),
              skipped:Number(a.Skipped), accuracy:Number(a.Accuracy)};
    })};
}

function sendStudentEmail(userId, token, targetUserId, message){
  var teacher = requireSession_(userId, token, 'teacher');
  var u = getUserById_(targetUserId);
  if(!u) throw err_('Student not found.');
  if(String(u.Role) !== 'student' || String(u.Status) !== 'approved') throw err_('Only approved students can be messaged.');
  message = String(message || '').trim();
  if(message.length < 1) throw err_('Write a message first.');
  if(message.length > 2000) throw err_('Message is too long (max 2000 characters).');
  var r = sendMailSafe_(String(u.Email), 'Message from your CEE teacher',
    'Hi ' + escHtml_(u.Name) + ',<br><br><div style="white-space:pre-wrap">' + escHtml_(message) + '</div><br>— ' + escHtml_(teacher.Name) + '<br>CEE Mock Portal');
  return {ok:true, emailed:r.emailed !== false,
          message:r.emailed === false ? 'Email quota exhausted — message not delivered.' : 'Message sent to ' + String(u.Name) + '.'};
}

/* ============================================================================
   PUBLIC API — IN-APP MESSAGING (student → teacher, teacher inbox)
   ============================================================================ */
function sendStudentMessage(userId, token, message){
  var u = requireSession_(userId, token);
  if(String(u.Role) !== 'student') throw err_('Only students can send messages here.');
  message = String(message || '').trim();
  if(message.length < 1) throw err_('Write a message first.');
  if(message.length > 2000) throw err_('Message is too long (max 2000 characters).');
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    appendObj_('Messages', {ID:'m-' + uid_(), FromUserId:String(u.ID), FromName:String(u.Name),
                            Message:message, CreatedAt:nowISO_(), Read:'false'});
    return {ok:true, message:'Message sent to your teacher.'};
  } finally {
    lock.releaseLock();
  }
}

function getInbox(userId, token){
  var u = requireSession_(userId, token);
  var isTeacher = String(u.Role) === 'teacher';
  var users = readTab_('Users');
  var byId = {};
  users.forEach(function(x){ byId[String(x.ID)] = x; });
  var rows = readTab_('Messages').filter(function(m){
    return isTeacher ? true : String(m.FromUserId) === String(u.ID);
  }).sort(function(a, b){ return new Date(b.CreatedAt) - new Date(a.CreatedAt); });
  var unread = 0;
  var messages = rows.map(function(m){
    var isUnread = isTeacher && String(m.Read) !== 'true';
    if(isUnread) unread++;
    var su = byId[String(m.FromUserId)];
    return {id:String(m.ID), from:String(m.FromUserId), name:String(m.FromName),
            email:su ? String(su.Email) : '',
            message:String(m.Message), at:String(m.CreatedAt), read:!isUnread};
  });
  return {role:String(u.Role), unread:unread, messages:messages};
}

function markInboxRead(userId, token){
  var u = requireSession_(userId, token, 'teacher');
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    var rows = readTab_('Messages');
    var marked = 0;
    rows.forEach(function(m){
      if(String(m.Read) !== 'true'){ patchRow_('Messages', m._row, {Read:'true'}); marked++; }
    });
    return {ok:true, marked:marked};
  } finally {
    lock.releaseLock();
  }
}

/* ============================================================================
   PUBLIC API — QUESTION BANK
   ============================================================================ */
function bank_(){
  ensureSheets_();
  var rows = readTab_('Questions');
  if(!rows.length){
    ensureSeed_();
    rows = readTab_('Questions');
  }
  return rows.map(function(r){
    return {id:String(r.ID), text:String(r.Text),
            opts:[String(r.OptA), String(r.OptB), String(r.OptC), String(r.OptD)],
            answer:parseInt(r.Answer, 10) || 0, section:legacySection_(r.Section),
            topic:String(r.Topic || ''), explanation:String(r.Explanation || ''), img:String(r.Image || ''),
            difficulty:normalizeDifficulty_(r.Difficulty)};
  });
}

function ensureSeed_(){
  var sh = getTab_('Questions');
  if(sh.getLastRow() > 1) return false;
  var now = nowISO_();
  var rows = FALLBACK_BANK.map(function(q){
    var qId = getNextQuestionId_(q.section);
    return [qId, q.text, q.opts[0], q.opts[1], q.opts[2], q.opts[3], q.answer,
            q.section, q.topic, q.explanation, q.img, normalizeDifficulty_(q.difficulty), now, now];
  });
  sh.getRange(2, 1, rows.length, 14).setValues(rows.map(function(row){
    return row.map(function(v){ return (typeof v === 'string') ? escCell_(v) : v; });
  }));
  return true;
}

function validateQuestion_(q){
  if(!String(q.text || '').trim() || !q.opts || q.opts.filter(function(o){ return String(o || '').trim(); }).length < 4)
    throw err_('Fill the question and all four options.');
  if(SECTIONS_.indexOf(String(q.section)) < 0 && SECTIONS_.indexOf(legacySection_(q.section)) < 0)
    throw err_('Pick a valid subject.');
  var img = String(q.img || '');
  if(img.length > MAX_IMAGE_CHARS) throw err_('Image is too large (max ~48KB after downscaling).');
}

function getAllQuestions(userId, token){
  requireSession_(userId, token, 'teacher');
  return bank_().slice(0, MAX_QUESTIONS_RETURNED);
}

function addQuestion(userId, token, q){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    requireSession_(userId, token, 'teacher');
    validateQuestion_(q);
    var t = norm_(q.text);
    if(bank_().some(function(x){ return norm_(x.text) === t; }))
      throw err_('A question with this text already exists in the bank.', 'DUPLICATE_QUESTION');
    var now = nowISO_();
    var qId = getNextQuestionId_(q.section);
    var row = {ID:qId, Text:String(q.text).trim(),
      OptA:String(q.opts[0]).trim(), OptB:String(q.opts[1]).trim(), OptC:String(q.opts[2]).trim(), OptD:String(q.opts[3]).trim(),
      Answer:Math.max(0, Math.min(3, parseInt(q.answer, 10) || 0)), Section:legacySection_(q.section),
      Topic:String(q.topic || '').toUpperCase(), Explanation:String(q.explanation || '').trim(),
      Image:String(q.img || ''), Difficulty:normalizeDifficulty_(q.difficulty), CreatedAt:now, UpdatedAt:now};
    appendObj_('Questions', row);
    return {ok:true, id:String(row.ID), message:'Question added.'};
  } finally {
    lock.releaseLock();
  }
}

function updateQuestion(userId, token, id, patch){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    requireSession_(userId, token, 'teacher');
    var q = findRowById_('Questions', id);
    if(!q) throw err_('Question not found.');
    if(liveDailyQuestionIds_()[String(q.ID)])
      throw err_('This question is part of a live model exam and is locked until the exam day is over.', 'MODEL_QUESTION_LOCKED');
    var p = {};
    if(patch.text != null){
      var t = norm_(patch.text);
      var clash = bank_().some(function(x){ return String(x.id) !== String(id) && norm_(x.text) === t; });
      if(clash) throw err_('Another question already has this text.', 'DUPLICATE_QUESTION');
      p.Text = String(patch.text).trim();
    }
    if(patch.opts){ p.OptA = String(patch.opts[0]).trim(); p.OptB = String(patch.opts[1]).trim();
                    p.OptC = String(patch.opts[2]).trim(); p.OptD = String(patch.opts[3]).trim(); }
    if(patch.answer != null) p.Answer = Math.max(0, Math.min(3, parseInt(patch.answer, 10) || 0));
    if(patch.section != null) p.Section = legacySection_(patch.section);
    if(patch.topic != null) p.Topic = String(patch.topic).toUpperCase();
    if(patch.explanation != null) p.Explanation = String(patch.explanation).trim();
    if(patch.img != null) p.Image = String(patch.img);
    if(patch.difficulty != null) p.Difficulty = normalizeDifficulty_(patch.difficulty);
    if(String(p.Image || '').length > MAX_IMAGE_CHARS) throw err_('Image is too large (max ~48KB after downscaling).');
    p.UpdatedAt = nowISO_();
    patchRow_('Questions', q._row, p);
    return {ok:true, message:'Question updated.'};
  } finally {
    lock.releaseLock();
  }
}

function deleteQuestion(userId, token, id){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    requireSession_(userId, token, 'teacher');
    if(liveDailyQuestionIds_()[String(id)])
      throw err_('This question is part of a live model exam and is locked until the exam day is over.', 'MODEL_QUESTION_LOCKED');
    if(!deleteRowById_('Questions', id)) throw err_('Question not found.');
    return {ok:true, message:'Question deleted.'};
  } finally {
    lock.releaseLock();
  }
}

/* opts (optional): {dryRun:true} validates every row and returns a per-row
   preview WITHOUT writing anything — used by the bulk-upload preview step. */
function bulkUploadQuestions(userId, token, rows, opts){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    requireSession_(userId, token, 'teacher');
    opts = opts || {};
    var dry = !!opts.dryRun;
    var inserted = 0, skipped = 0, errors = [];
    var preview = [];
    var seen = {};
    var existingNorm = bank_().map(function(x){ return norm_(x.text); });
    rows = rows || [];
    for(var idx = 0; idx < rows.length; idx++){
      var r = rows[idx];
      var line = 'Row ' + (idx + 1);
      var pv = {row:idx + 1, text:'', answer:'', section:'', topic:'', difficulty:'', status:'insert', reason:''};
      var fail = function(msg){ pv.status = 'skip'; pv.reason = msg; errors.push(line + ': ' + msg); skipped++; preview.push(pv); };
      if(!r.QUESTION || !r.A || !r.B || !r.C || !r.D || r.ANSWER == null || !r.SECTION){
        fail('missing required fields'); continue;
      }
      pv.text = String(r.QUESTION).trim();
      pv.answer = String(r.ANSWER).trim().toUpperCase();
      pv.section = String(r.SECTION).trim();
      pv.topic = String(r.TOPIC || '').toUpperCase().trim();
      pv.difficulty = normalizeDifficulty_(r.DIFFICULTY);
      var key = norm_(r.QUESTION);
      if(existingNorm.indexOf(key) >= 0){
        fail('duplicate question (already in the bank)'); continue;
      }
      if(seen[key]){
        fail('duplicate question (repeated in this batch)'); continue;
      }
      seen[key] = true;
      var sec = legacySection_(String(r.SECTION).trim());
      if(SECTIONS_.indexOf(sec) < 0){
        fail('unknown subject "' + r.SECTION + '"'); continue;
      }
      var ans = String(r.ANSWER).trim().toUpperCase();
      var ansIdx = 'ABCD'.indexOf(ans) >= 0 ? 'ABCD'.indexOf(ans) : (parseInt(ans, 10) - 1);
      if(!(ansIdx >= 0 && ansIdx <= 3)){
        fail('answer must be A–D'); continue;
      }
      if(r.IMAGE && String(r.IMAGE).length > MAX_IMAGE_CHARS){
        fail('image too large'); continue;
      }
      var diff = normalizeDifficulty_(r.DIFFICULTY);
      if(!dry){
        var now = nowISO_();
        var qId = getNextQuestionId_(sec);
        appendObj_('Questions', {ID:qId, Text:String(r.QUESTION).trim(),
          OptA:String(r.A).trim(), OptB:String(r.B).trim(), OptC:String(r.C).trim(), OptD:String(r.D).trim(),
          Answer:ansIdx, Section:sec, Topic:String(r.TOPIC || '').toUpperCase().trim(),
          Explanation:String(r.EXPLANATION || '').trim(), Image:String(r.IMAGE || ''),
          Difficulty:diff, CreatedAt:now, UpdatedAt:now});
      }
      existingNorm.push(key);
      inserted++;
      preview.push(pv);
    }
    if(dry){
      return {ok:true, dryRun:true, inserted:inserted, skipped:skipped, errors:errors, preview:preview,
              message:'Preview: ' + inserted + ' question' + (inserted === 1 ? '' : 's') + ' ready to insert' +
                      (skipped ? ', ' + skipped + ' will be skipped' : '') + '.'};
    }
    return {ok:true, inserted:inserted, skipped:skipped, errors:errors,
            message:'Uploaded ' + inserted + ' question' + (inserted === 1 ? '' : 's') +
                    (skipped ? ', skipped ' + skipped : '') + '.'};
  } finally {
    lock.releaseLock();
  }
}

/* ============================================================================
   EMAILS (MailApp, quota-aware)
   ============================================================================ */
function escHtml_(s){
  return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function sendMailSafe_(to, subject, htmlBody){
  try{
    if(MailApp.getRemainingDailyQuota() <= 0) return {emailed:false};
    MailApp.sendEmail({to:to, subject:subject, htmlBody:
      '<div style="font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#1f2333;max-width:560px">' + htmlBody +
      '<hr style="border:none;border-top:1px solid #e2e5f0;margin:18px 0"><span style="color:#8a90ad;font-size:12px">CEE Mock Portal — automated message</span></div>'});
    return {emailed:true};
  }catch(e){
    return {emailed:false};
  }
}

function emailNewRegistration_(u){
  var teachers = readTab_('Users').filter(function(x){ return String(x.Role) === 'teacher'; });
  teachers.forEach(function(t){
    sendMailSafe_(String(t.Email), 'CEE Portal — new registration pending',
      'New student registration:<br><br>Name: <b>' + escHtml_(u.Name) + '</b><br>Email: ' + escHtml_(u.Email) +
      '<br>Username: ' + escHtml_(u.Username) + '<br><br>Approve or reject this user from the teacher dashboard.');
  });
}

function emailResult_(u, r){
  var note = r.negMarking ? 'Wrong answers were penalised −0.25.' : 'No negative marking was applied for this practice session.';
  var rows = reviewRowsForEmail_(r.id);
  sendMailSafe_(String(u.Email), 'CEE Portal — result: ' + r.score + '/' + r.total,
    'Hi ' + escHtml_(u.Name) + ',<br><br>Your ' + escHtml_(r.mode) + ' session has been scored.<br><br>' +
    '<b>Score: ' + r.score + ' / ' + r.total + ' (' + r.accuracy + '%)</b><br>' +
    'Correct: ' + r.correct + ' · Wrong: ' + r.wrong + ' · Skipped: ' + r.skipped + '<br>' + note +
    (rows ? '<br><br><table border="1" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-size:12.5px">' +
      '<tr style="background:#f0f2fa"><th>#</th><th>Question</th><th>Outcome</th></tr>' + rows + '</table>' : '') +
    '<br>Sign in to review your answers.');
}
function reviewRowsForEmail_(attemptId){
  try{
    var bank = bank_();
    var byText = {};
    bank.forEach(function(q){ byText[norm_(q.text)] = q; });
    return readTab_('Responses').filter(function(x){ return String(x.AttemptId) === String(attemptId); })
      .slice(0, 40)
      .map(function(x, i){
        var isC = String(x.IsCorrect) === 'true';
        var chosen = parseInt(x.Chosen, 10);
        var skipped = chosen < 0;
        var color = skipped ? '#888' : isC ? '#0a7d43' : '#b91c1c';
        var label = skipped ? 'Skipped' : isC ? 'Correct' : 'Wrong';
        return '<tr><td>' + (i + 1) + '</td><td>' + escHtml_(String(x.QuestionText).slice(0, 120)) + '</td>' +
               '<td style="color:' + color + ';font-weight:600">' + label + '</td></tr>';
      }).join('');
  }catch(e){
    return '';
  }
}

