function doGet(e){
  ensureSheets_();
  /* JSONP / plain-JSON API for the statically hosted frontend (GitHub Pages).
     ?fn=loginUser&args=[...]  (&callback=cb for JSONP) */
  if(e && e.parameter && e.parameter.fn) return apiRespond_(e.parameter.fn, e.parameter.args, e.parameter.callback);
  var html = Utilities.newBlob(Utilities.base64Decode(EMBEDDED_HTML)).getDataAsString();
  return HtmlService.createHtmlOutput(html)
    .setTitle('CEE Mock Portal')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

/* ----------------------------------------------------------------------------
   doPost — JSON gateway used by index.html when it is NOT served by this web
   app (GitHub Pages build). The frontend posts {fn, args} as text/plain so the
   browser treats it as a "simple" CORS request (Apps Script cannot reply to a
   preflight OPTIONS). Response: {ok:true, result} or {ok:false, error}.
   Deploy as: Execute as = Me, Who has access = Anyone.
   -------------------------------------------------------------------------- */
function doPost(e){
  ensureSheets_();
  var body = {};
  try{ body = JSON.parse((e && e.postData && e.postData.contents) || '{}'); }
  catch(parseErr){ return apiJson_({ok: false, error: 'Malformed request'}, null); }
  return apiRespond_(body.fn, body.args, body.callback);
}

/** Functions the public web API is allowed to call. */
var API_ALLOWED = {
  registerUser:1, loginUser:1, logoutUser:1, restoreSession:1, changePassword:1,
  approve:1, promoteToTeacher:1, reject:1, resetDevice:1,
  startMockExam:1, submitExam:1, getAttemptReview:1,
  generateDailyExam:1, getDailyExamStatus:1, startDailyExam:1,
  getDailyLeaderboard:1, setDailyAutopilot:1,
  getStudentStats:1, getStudentAnalytics:1, getLeaderboard:1,
  getTeacherStats:1, getTeacherAnalytics:1, getStudentDetail:1,
  sendStudentEmail:1, sendStudentMessage:1, getInbox:1, markInboxRead:1,
  getAllQuestions:1, addQuestion:1, updateQuestion:1, deleteQuestion:1,
  bulkUploadQuestions:1
};

function apiRespond_(fn, args, callback){
  var payload;
  try{
    var G = (typeof globalThis !== 'undefined') ? globalThis : this;
    if(!fn || !API_ALLOWED[fn] || typeof G[fn] !== 'function') throw new Error('Unknown action: ' + fn);
    var list = args;
    if(typeof list === 'string') list = JSON.parse(list || '[]');
    if(!list) list = [];
    if(!(list instanceof Array)) list = [list];
    payload = {ok: true, result: G[fn].apply(null, list)};
  }catch(ex){
    payload = {ok: false, error: (ex && ex.message) ? ex.message : String(ex)};
  }
  return apiJson_(payload, callback);
}

function apiJson_(payload, callback){
  var json = JSON.stringify(payload);
  if(callback && /^[A-Za-z_$][\w$.]*$/.test(callback)){
    return ContentService.createTextOutput(callback + '(' + json + ');')
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }
  return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON);
}

