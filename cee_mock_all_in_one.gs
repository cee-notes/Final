/** Called by the dialog: creates an already-approved student and emails credentials. */
function registerStudentFromSheet(form){
  form = form || {};
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    ensureSheets_();
    var name = String(form.name || '').trim();
    var email = String(form.email || '').toLowerCase().trim();
    var username = String(form.username || '').toLowerCase().trim();
    var password = String(form.password || '');
    if(name.length < 2) throw err_('Please enter the student\u2019s full name.');
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw err_('Please enter a valid email address.');
    if(username.length < 3 || !/^[a-z0-9_.]+$/.test(username)) throw err_('Username must be 3+ characters (letters, numbers, dot or underscore).');
    if(password.length < 6) throw err_('Password must be at least 6 characters.');
    if(getUserByEmail_(email)) throw err_('An account with this email already exists.');
    if(readTab_('Users').some(function(u){ return String(u.Username) === username; })) throw err_('This username is already taken.');
    var u = {ID:getNextStudentId_(), Name:name, Email:email, Username:username,
             PassHash:hashPassword(password), Role:'student', Status:'approved',
             CreatedAt:nowISO_(), DeviceId:'', SessionToken:'', SessionExpires:'', Notes:''};
    appendObj_('Users', u);
    sendMailSafe_(email, 'CEE Portal — your account is ready',
      'Hi ' + escHtml_(name) + ',<br><br>Your CEE Mock Portal account has been created by your teacher.<br><br>' +
      'Sign in with:<br>Username: <b>' + escHtml_(username) + '</b> (or your email)<br>' +
      'Password: <b>' + escHtml_(password) + '</b><br><br>' +
      'Please change your password from Settings after your first sign-in.');
    buildDashboard_();
    return {ok:true, message:name + ' registered and approved — sign-in details emailed to ' + email + '.'};
  } finally {
    lock.releaseLock();
  }
}

