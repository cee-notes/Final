/* ============================================================================
   SHEET ADMIN CONSOLE — menu, live dashboard, friendly formatting, edit watcher
   ----------------------------------------------------------------------------
   The spreadsheet is not just a database: open it and you get a "🎓 CEE Portal"
   menu (approve registrations, register a student, generate the model exam,
   autopilot, refresh), a live Dashboard tab with counts, dropdowns + colour
   coding on the data tabs, and (optionally) automatic emails when a teacher
   edits a registration Status cell by hand.
   ============================================================================ */
var DASH_NAME_ = 'Dashboard';
var EDIT_WATCH_HANDLER_ = 'onSheetEdit_';

/** Runs when the spreadsheet is opened: menu + tabs + dashboard. */
function onOpen(){
  try{
    ensureSheets_();
  }catch(e){ /* limited auth mode or race — the menu items retry anyway */ }
  try{
    SpreadsheetApp.getUi()
      .createMenu('🎓 CEE Portal')
      .addItem('✅ Approve all pending registrations', 'menuApproveAllPending')
      .addItem('📋 Register a student…', 'menuRegisterStudent')
      .addSeparator()
      .addItem('📅 Generate today\u2019s model exam', 'menuGenerateDaily')
      .addItem('⏰ Toggle model-exam autopilot', 'menuToggleAutopilot')
      .addSeparator()
      .addItem('⚡ Toggle auto-respond to sheet edits', 'menuToggleEditWatcher')
      .addItem('📊 Refresh dashboard & formatting', 'menuRefreshSheet')
      .addItem('🔗 Show web app URL', 'menuShowUrl')
      .addSeparator()
      .addItem('ℹ️ About / quick guide', 'menuAbout')
      .addToUi();
  }catch(e){ /* not opened as a spreadsheet UI — ignore */ }
}

/* ---------------- dashboard ---------------- */
