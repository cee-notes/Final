  }
}

/* ============================================================================
   PUBLIC API — EXAMS
   ============================================================================ */
var EXAM_META_KEY_ = 'CEE_EXAM_META_';

function startMockExam(userId, token, options){
  var u = requireSession_(userId, token);
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    var opts = normalizeExamOptions_(options);
    var bank = bank_();
    if(!bank.length) throw err_('The question bank is empty. Please ask your teacher to add questions.', 'EMPTY_BANK');
    var attempts = readTab_('Attempts');
    var attemptIndex = attempts.filter(function(a){ return String(a.UserId) === String(u.ID); }).length + 1;
    var startedAt = nowISO_();
    var sig = examOptsSignature_(opts);
    var seedKey = strSeed_(String(u.ID) + '|' + startedAt + '|' + sig);
    var set = buildExamSet_(bank, opts, seedKey);
    if(!set.length) throw err_('No questions match the selected subjects/topics. Try widening your filter.', 'EMPTY_FILTER');
    var durMin = opts.mode === 'mock' ? ceeDurationFor_(set.length) : (opts.timed ? opts.durationMinutes : 0);
    var deadline = opts.timed ? new Date(Date.now() + durMin * 60000).toISOString() : '';
    PropertiesService.getScriptProperties().setProperty(EXAM_META_KEY_ + u.ID,
      JSON.stringify({start:startedAt, dur:durMin, opts:opts, sig:sig, attemptIndex:attemptIndex}));
    var qs = set.map(function(q){
      var out = {id:String(q.id), text:String(q.text), opts:[String(q.opts[0]),String(q.opts[1]),String(q.opts[2]),String(q.opts[3])],
                 section:String(q.section), topic:String(q.topic || ''), img:String(q.img || '')};
      if(opts.ifb){ out.answer = parseInt(q.answer, 10); out.explanation = String(q.explanation || ''); }
      return out;
    });
    return {attemptIndex:attemptIndex, startedAt:startedAt, durMin:durMin, deadline:deadline,
            opts:opts, questions:qs};
  } finally {
    lock.releaseLock();
  }
}

function submitExam(userId, token, data){
  var u = requireSession_(userId, token);
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    data = data || {};
    var attemptIndex = data.attemptIndex != null ? data.attemptIndex : null;
    /* --- idempotency: matching stored attempt returned as-is (meta untouched) --- */
    var attempts = readTab_('Attempts');
    var existing = null;
    for(var i = 0; i < attempts.length; i++){
      if(String(attempts[i].UserId) === String(u.ID) && String(attempts[i].AttemptIndex) === String(attemptIndex)){ existing = attempts[i]; break; }
    }
    if(existing){
      return {duplicate:true, id:String(existing.ID), score:Number(existing.Score), total:Number(existing.Total),
              correct:Number(existing.Correct), wrong:Number(existing.Wrong), skipped:Number(existing.Skipped),
              accuracy:Number(existing.Accuracy), section:String(existing.Section), mode:String(existing.Mode),
              dailyDate:String(existing.DailyDate || ''),
              negMarking:String(existing.Mode) !== 'practice', autoSubmitted:String(existing.AutoSubmitted) === 'true',
              late:String(existing.Late) === 'true'};
    }
    /* --- authoritative options come from the stored meta only --- */
    var props = PropertiesService.getScriptProperties();
    var meta = null;
    var rawMeta = props.getProperty(EXAM_META_KEY_ + u.ID);
    if(rawMeta){
      try{ meta = JSON.parse(rawMeta); }catch(e){ meta = null; }
    }
    var opts, startedAt;
    var metaMatches = !!(meta && meta.attemptIndex != null && String(meta.attemptIndex) === String(attemptIndex));
    if(metaMatches){
      opts = meta.opts; startedAt = meta.start;
    } else if(String(data.mode || '') === 'model'){
      /* a model exam can ONLY be scored against its server-stored paper */
      throw err_('Your model-exam session was not found on the server. Please start today\'s model exam again.', 'MODEL_NO_META');
    } else {
      opts = normalizeExamOptions_(null); /* client options are NEVER trusted for scoring */
      startedAt = data.startedAt ? String(data.startedAt) : nowISO_();
    }
    /* --- rebuild the deterministic set, fall back to text matching on bank drift --- */
    var bank = bank_();
    var rebuilt;
    if(opts.mode === 'model'){
      var byId_ = {};
      bank.forEach(function(q){ byId_[String(q.id)] = q; });
      rebuilt = (opts.qids || []).map(function(id){ return byId_[String(id)]; }).filter(Boolean);
    } else {
      var sig = examOptsSignature_(opts);
      var seedKey = strSeed_(String(u.ID) + '|' + startedAt + '|' + sig);
      rebuilt = buildExamSet_(bank, opts, seedKey);
    }
    var byText = {};
    rebuilt.forEach(function(q){ byText[norm_(q.text)] = q; });
    var items = (data.qs || []).map(function(snap){
      var q = byText[norm_(snap.text)];
      if(!q){
        for(var k = 0; k < bank.length; k++){
          if(norm_(bank[k].text) === norm_(snap.text)){ q = bank[k]; break; }
        }
      }
      if(!q && snap.answer != null && opts.mode === 'practice') q = snap; /* ifb snapshot carries its own key */
      var chosen = (data.answers && data.answers[snap.id] != null) ? data.answers[snap.id] : -1;
      return {q:q, chosen:chosen};
    });
    /* --- score (server-side only) --- */
    var neg = opts.negMarking, correct = 0, wrong = 0, skipped = 0, score = 0;
    items.forEach(function(it){
      var r = scoreItem_(it.q, it.chosen, neg);
      if(r.state === 'correct'){ correct++; score += 1; }
      else if(r.state === 'wrong'){ wrong++; score += r.pts; }
      else skipped++;
    });
    score = Math.round(score * 100) / 100;
    var total = items.length;
    var submittedAt = nowISO_();
    var late = false;
    if(opts.timed && meta && String(meta.attemptIndex) === String(attemptIndex) && Number(meta.dur) > 0){
      late = (new Date(submittedAt) - new Date(meta.start)) > (Number(meta.dur) * 60 + EXAM_GRACE_MS / 1000) * 1000;
    }
    var secCounts = {};
    items.forEach(function(it){ if(it.q) secCounts[it.q.section] = (secCounts[it.q.section] || 0) + 1; });
    var secStr = Object.keys(secCounts).map(function(s){ return s + ':' + secCounts[s]; }).join('|');
    if(opts.mode === 'practice') secStr = 'PRACTICE|' + secStr;
    if(opts.mode === 'model') secStr = 'MODEL|' + secStr;
    var attemptId = 'a-' + uid_();
    appendObj_('Attempts', {ID:attemptId, AttemptIndex:String(attemptIndex), UserId:String(u.ID),
      StartedAt:startedAt, SubmittedAt:submittedAt, DurMin:Number((meta && String(meta.attemptIndex) === String(attemptIndex)) ? meta.dur : (data.dur || 0)),
      DailyDate:opts.mode === 'model' ? String(opts.dailyDate || '') : '',
      Deadline:(meta && String(meta.attemptIndex) === String(attemptIndex) && opts.timed) ? new Date(new Date(meta.start).getTime() + Number(meta.dur) * 60000).toISOString() : '',
      Section:secStr, Mode:opts.mode, NegMarking:neg ? 'true' : 'false', Score:score, Total:total,
      Correct:correct, Wrong:wrong, Skipped:skipped,
      Accuracy: total ? Math.round(correct / total * 1000) / 10 : 0,
      AutoSubmitted:data.autoSubmitted ? 'true' : 'false', Late:late ? 'true' : 'false'});
    items.forEach(function(it, idx){
      if(!it.q) return;
      appendObj_('Responses', {ID:attemptId + '-r' + idx, AttemptId:attemptId, UserId:String(u.ID),
        QId:String(it.q.id || ''), QuestionText:String(it.q.text),
        Chosen:(it.chosen == null ? -1 : parseInt(it.chosen, 10)),
        IsCorrect:(it.chosen != null && parseInt(it.chosen, 10) >= 0 && parseInt(it.chosen, 10) === parseInt(it.q.answer, 10)) ? 'true' : 'false',
        Section:String(it.q.section), Topic:String(it.q.topic || '')});
    });
    if(meta && String(meta.attemptIndex) === String(attemptIndex)){
      props.deleteProperty(EXAM_META_KEY_ + u.ID);
    }
    emailResult_(u, {score:score, total:total, correct:correct, wrong:wrong, skipped:skipped,
                     accuracy: total ? Math.round(correct / total * 1000) / 10 : 0,
                     mode:opts.mode, negMarking:neg, id:attemptId});
    return {id:attemptId, score:score, total:total, correct:correct, wrong:wrong, skipped:skipped,
            accuracy: total ? Math.round(correct / total * 1000) / 10 : 0,
            section:secStr, mode:opts.mode, dailyDate:opts.mode === 'model' ? String(opts.dailyDate || '') : '',
            negMarking:neg,
            autoSubmitted:!!data.autoSubmitted, late:late, duplicate:false};
  } finally {
    lock.releaseLock();
  }
}

function getAttemptReview(userId, token, attemptId){
  var u = requireSession_(userId, token);
  var rows = readTab_('Attempts');
  var a = null;
  for(var i = 0; i < rows.length; i++){
    if(String(rows[i].ID) === String(attemptId)){ a = rows[i]; break; }
  }
  if(!a) throw err_('Attempt not found.');
  var teacherView = String(a.UserId) !== String(u.ID) && String(u.Role) === 'teacher';
  if(String(a.UserId) !== String(u.ID) && String(u.Role) !== 'teacher') throw err_('Not allowed.', 'FORBIDDEN');
  /* teacher reports carry the student identity for the print stamp */
  var student = null;
  if(teacherView){
    var su = getUserById_(a.UserId);
    if(su) student = {id:String(su.ID), name:String(su.Name), email:String(su.Email)};
  }
  var bank = bank_();
  var byText = {};
  bank.forEach(function(q){ byText[norm_(q.text)] = q; });
  var resps = readTab_('Responses').filter(function(r){ return String(r.AttemptId) === String(attemptId); });
  var items = resps.map(function(r){
    var q = byText[norm_(r.QuestionText)];
    return {id:String(r.QId), text:String(r.QuestionText),
            opts:q ? [String(q.opts[0]),String(q.opts[1]),String(q.opts[2]),String(q.opts[3])] : ['—','—','—','—'],
            answer:q ? parseInt(q.answer, 10) : -1,
            chosen:parseInt(r.Chosen, 10), section:String(r.Section), topic:String(r.Topic || ''),
            img:q ? String(q.img || '') : '',
            explanation:q ? String(q.explanation || '') : '(This question has been removed or edited since the attempt.)'};
  });
  return {id:String(a.ID), score:Number(a.Score), total:Number(a.Total), correct:Number(a.Correct),
          wrong:Number(a.Wrong), skipped:Number(a.Skipped), accuracy:Number(a.Accuracy),
          section:String(a.Section), mode:String(a.Mode), negMarking:String(a.NegMarking) === 'true',
          submittedAt:String(a.SubmittedAt), autoSubmitted:String(a.AutoSubmitted) === 'true',
          late:String(a.Late) === 'true', student:student, items:items};
}

/* ============================================================================
   PUBLIC API — MODEL EXAM OF THE DAY (schema v3)
   One fixed paper per calendar date: the same questions in the same order for
   every student, one attempt each, daily leaderboard + rank, 7-day history,
   optional autopilot via a time-driven trigger at MODEL_AUTO_HOUR.
   ============================================================================ */
function dailyDateStr_(offsetDays){
  var d = new Date();
  if(offsetDays) d.setDate(d.getDate() + (offsetDays));
  return Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

function findDailyExam_(dateStr){
  var rows = readTab_('DailyExams');
  for(var i = 0; i < rows.length; i++){
    if(String(rows[i].Date) === dateStr) return rows[i];
  }
  return null;
}

/* Largest-remainder apportionment of `total` questions across blueprint
   weights — 20 questions becomes exactly 4/4/5/5/2, never 5/4/5/4/1. */
function apportion_(total, weights){
  var base = weights.reduce(function(a, b){ return a + b; }, 0);
  var raw = weights.map(function(w){ return total * w / base; });
  var counts = raw.map(Math.floor);
  var rem = total - counts.reduce(function(a, b){ return a + b; }, 0);
  raw.map(function(r, i){ return {i:i, f:r - Math.floor(r)}; })
     .sort(function(a, b){ return b.f - a.f; })
     .slice(0, rem)
     .forEach(function(x){ counts[x.i]++; });
  return counts;
}

/* The daily paper is seeded from the DATE alone — identical for everyone and
   reproducible on every rebuild, difficulty-weighted like the big mocks. */
function buildDailySet_(dateStr, count){
  var bank = bank_();
  if(!bank.length) return [];
  var seed = strSeed_('cee-daily|' + dateStr);
  var counts = apportion_(count, CEE_BLUEPRINT_.map(function(b){ return b.n; }));
  var bySection = {};
  bank.forEach(function(q){ (bySection[q.section] = bySection[q.section] || []).push(q); });
  var takes = [], used = {};
  CEE_BLUEPRINT_.forEach(function(b, i){
    var pool = seededShuffle_(bySection[b.section] || [], seed + i * 7919);
    var take = pickByDifficulty_(pool, counts[i]);
    takes.push(take);
    take.forEach(function(q){ used[q.id] = true; });
  });
  var picked = takes.reduce(function(n, t){ return n + t.length; }, 0);
  if(picked < count){
    var rest = bank.filter(function(q){ return !used[q.id]; });
    seededShuffle_(rest, seed + 104729).slice(0, count - picked).forEach(function(q){
      takes[takes.length - 1].push(q);
    });
  }
  var out = [];
  takes.forEach(function(t){ out = out.concat(t); });
  return out.slice(0, count);
}

function generateDailyExamForDate_(dateStr, count, by){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    ensureSheets_();
    var existing = findDailyExam_(dateStr);
    if(existing){
      var attempted = readTab_('Attempts').some(function(a){
        return String(a.Mode) === 'model' && String(a.DailyDate) === dateStr;
      });
      if(attempted){
        throw err_('Students have already attempted the ' + dateStr + ' model exam — it cannot be regenerated.', 'MODEL_ATTEMPTED');
      }
    }
    var set = buildDailySet_(dateStr, count);
    if(!set.length) throw err_('The question bank is empty. Add questions first.', 'EMPTY_BANK');
    var row = {Date:dateStr, QIds:set.map(function(q){ return String(q.id); }).join(','),
               Count:set.length, DurMin:ceeDurationFor_(set.length), Status:'live',
               GeneratedBy:by || 'auto', GeneratedAt:nowISO_()};
    if(existing) patchRow_('DailyExams', existing._row, row);
    else appendObj_('DailyExams', row);
    return {ok:true, date:dateStr, count:set.length, durMin:row.DurMin};
  } finally {
    lock.releaseLock();
  }
}

/** Teacher: (re)generate today's model exam (default 20 questions). */
function generateDailyExam(userId, token, opts){
  requireSession_(userId, token, 'teacher');
  opts = opts || {};
  var count = Math.max(5, Math.min(50, parseInt(opts.count, 10) || MODEL_DEFAULT_COUNT));
  return generateDailyExamForDate_(dailyDateStr_(0), count, 'teacher');
}

/** Trigger entry (no session): pre-generate TOMORROW's paper at MODEL_AUTO_HOUR. */
function autoGenerateDailyExam(){
  generateDailyExamForDate_(dailyDateStr_(1), MODEL_DEFAULT_COUNT, 'autopilot');
}

function dailyBoardForDate_(dateStr){
  return readTab_('Attempts')
    .filter(function(a){ return String(a.Mode) === 'model' && String(a.DailyDate) === dateStr; })
    .sort(function(a, b){
      var d = Number(b.Score) - Number(a.Score);
      if(d) return d;
      d = Number(b.Accuracy) - Number(a.Accuracy);
      if(d) return d;
      return new Date(a.SubmittedAt) - new Date(b.SubmittedAt);
    });
}

/** Student: today's paper info, my attempt, my rank. Generates on demand. */
function getDailyExamStatus(userId, token){
  var u = requireSession_(userId, token);
  var dateStr = dailyDateStr_(0);
  var paper = findDailyExam_(dateStr);
  if(!paper){
    try{ generateDailyExamForDate_(dateStr, MODEL_DEFAULT_COUNT, 'auto'); paper = findDailyExam_(dateStr); }
    catch(e){ paper = null; }
  }
  if(!paper) return {date:dateStr, exists:false, attempted:false, participants:0};
  var mine = readTab_('Attempts').filter(function(a){
    return String(a.Mode) === 'model' && String(a.DailyDate) === dateStr && String(a.UserId) === String(u.ID);
  })[0] || null;
  var board = dailyBoardForDate_(dateStr);
  var rank = null;
  if(mine) board.forEach(function(a, i){ if(String(a.UserId) === String(u.ID)) rank = i + 1; });
  return {date:dateStr, exists:String(paper.Status) === 'live',
          count:Number(paper.Count), durMin:Number(paper.DurMin),
          attempted:!!mine,
          myScore:mine ? Number(mine.Score) : null,
          myTotal:mine ? Number(mine.Total) : null,
          myAccuracy:mine ? Number(mine.Accuracy) : null,
          myRank:rank, participants:board.length};
}

/** Student: start today's model exam — one attempt per student per date. */
function startDailyExam(userId, token){
  var u = requireSession_(userId, token);
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    var dateStr = dailyDateStr_(0);
    var paper = findDailyExam_(dateStr);
    if(!paper || String(paper.Status) !== 'live'){
      generateDailyExamForDate_(dateStr, MODEL_DEFAULT_COUNT, 'auto');
      paper = findDailyExam_(dateStr);
    }
    if(!paper) throw err_('No model exam is available today.', 'MODEL_UNAVAILABLE');
    var attempts = readTab_('Attempts');
    var mineToday = attempts.filter(function(a){
      return String(a.Mode) === 'model' && String(a.DailyDate) === dateStr && String(a.UserId) === String(u.ID);
    });
    if(mineToday.length){
      throw err_('You have already taken today\'s model exam — one attempt per day. See the daily leaderboard for your result.', 'MODEL_ALREADY_DONE');
    }
    var byId = {};
    bank_().forEach(function(q){ byId[String(q.id)] = q; });
    var set = String(paper.QIds).split(',').map(function(id){ return byId[id]; }).filter(Boolean);
    if(!set.length) throw err_('Today\'s model exam could not be loaded. Ask your teacher to regenerate it.', 'MODEL_BROKEN');
    var attemptIndex = attempts.filter(function(a){ return String(a.UserId) === String(u.ID); }).length + 1;
    var startedAt = nowISO_();
    var durMin = Number(paper.DurMin) || ceeDurationFor_(set.length);
    var opts = {mode:'model', dailyDate:dateStr, qids:set.map(function(q){ return String(q.id); }),
                subjects:[], topics:[], count:set.length,
                timed:true, durationMinutes:durMin, negMarking:true, ifb:false};
    PropertiesService.getScriptProperties().setProperty(EXAM_META_KEY_ + u.ID,
      JSON.stringify({start:startedAt, dur:durMin, opts:opts, sig:'model|' + dateStr, attemptIndex:attemptIndex}));
    var qs = set.map(function(q){
      return {id:String(q.id), text:String(q.text),
              opts:[String(q.opts[0]), String(q.opts[1]), String(q.opts[2]), String(q.opts[3])],
              section:String(q.section), topic:String(q.topic || ''), img:String(q.img || '')};
    });
    return {attemptIndex:attemptIndex, startedAt:startedAt, durMin:durMin,
            deadline:new Date(Date.now() + durMin * 60000).toISOString(),
            opts:opts, questions:qs};
  } finally {
    lock.releaseLock();
  }
}

/** Daily leaderboard (today) + my last MODEL_HISTORY_DAYS daily results. */
function getDailyLeaderboard(userId, token){
  var u = requireSession_(userId, token);
  var dateStr = dailyDateStr_(0);
  var users = readTab_('Users'), names = {};
  users.forEach(function(x){ names[String(x.ID)] = String(x.Name); });
  var board = dailyBoardForDate_(dateStr).map(function(a, i){
    return {rank:i + 1, name:names[String(a.UserId)] || 'Student', score:Number(a.Score),
            total:Number(a.Total), accuracy:Number(a.Accuracy)};
  });
  var myRank = null;
  board.forEach(function(r){ if(r.name === (names[String(u.ID)] || '')) myRank = myRank || r.rank; });
  var history = [];
  for(var d = 1; d < MODEL_HISTORY_DAYS; d++){
    var ds = dailyDateStr_(-d);
    var b = dailyBoardForDate_(ds);
    var mine = b.filter(function(a){ return String(a.UserId) === String(u.ID); })[0] || null;
    if(mine || b.length){
      var rank = null;
      b.forEach(function(a, i){ if(String(a.UserId) === String(u.ID)) rank = i + 1; });
      history.push({date:ds, myScore:mine ? Number(mine.Score) : null,
                    myTotal:mine ? Number(mine.Total) : null,
                    myAccuracy:mine ? Number(mine.Accuracy) : null,
                    myRank:rank, participants:b.length});
    }
  }
  return {date:dateStr, rows:board.slice(0, 20), myRank:myRank,
          participants:board.length, history:history, autopilot:dailyAutopilotOn_()};
}

/** Core: remove any existing daily trigger, then (re)create it when `on`. */
function toggleAutopilot_(on){
  var triggers = ScriptApp.getProjectTriggers();
  for(var i = 0; i < triggers.length; i++){
    if(triggers[i].getHandlerFunction() === 'autoGenerateDailyExam'){
      ScriptApp.deleteTrigger(triggers[i]);
    }
  }
  if(on){
    ScriptApp.newTrigger('autoGenerateDailyExam')
      .timeBased().atHour(MODEL_AUTO_HOUR).nearMinute(0).everyDays(1).create();
  }
  return !!on;
}

/** Teacher: enable/disable the daily autopilot trigger (MODEL_AUTO_HOUR). */
function setDailyAutopilot(userId, token, on){
  requireSession_(userId, token, 'teacher');
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    var state = toggleAutopilot_(on);
    return {ok:true, autopilot:state,
            message:state ? ('Autopilot on — tomorrow\'s model exam is generated daily at ' + MODEL_AUTO_HOUR + ':00 script time.')
                          : 'Autopilot off.'};
  } finally {
    lock.releaseLock();
  }
}

function dailyAutopilotOn_(){
  try{
    var ts = ScriptApp.getProjectTriggers();
    for(var i = 0; i < ts.length; i++){
      if(ts[i].getHandlerFunction() === 'autoGenerateDailyExam') return true;
    }
  }catch(e){}
  return false;
}

/* Question ids that belong to a live daily paper (today or pre-generated for
   tomorrow) are locked against edits and deletes while the exam is live. */
function liveDailyQuestionIds_(){
  var ids = {};
  [0, 1].forEach(function(off){
    var p = findDailyExam_(dailyDateStr_(off));
    if(p && String(p.Status) === 'live'){
      String(p.QIds).split(',').forEach(function(id){ if(id) ids[id] = true; });
    }
  });
  return ids;
}

/* ============================================================================
   PUBLIC API — STUDENT DATA
   ============================================================================ */
function getStudentStats(userId, token){
  var u = requireSession_(userId, token);
  var mine = readTab_('Attempts').filter(function(a){ return String(a.UserId) === String(u.ID); })
    .sort(function(a, b){ return new Date(b.SubmittedAt) - new Date(a.SubmittedAt); });
  var answered = readTab_('Responses').filter(function(r){ return String(r.UserId) === String(u.ID); }).length;
  var avgAcc = mine.length ? Math.round(mine.reduce(function(s, a){ return s + Number(a.Accuracy); }, 0) / mine.length * 10) / 10 : 0;
  var best = mine.length ? Math.max.apply(null, mine.map(function(a){ return Number(a.Score); })) : 0;
  return {stats:{attempts:mine.length, avgAcc:avgAcc, best:best, answered:answered},
    attempts:mine.map(function(a){
      return {id:String(a.ID), at:String(a.SubmittedAt), type:String(a.Mode), section:String(a.Section),
              score:Number(a.Score), total:Number(a.Total), correct:Number(a.Correct), wrong:Number(a.Wrong),
              skipped:Number(a.Skipped), accuracy:Number(a.Accuracy), mode:String(a.Mode),
              negMarking:String(a.NegMarking) === 'true'};
    })};
}

function responsesAgg_(userId){
  var rs = readTab_('Responses').filter(function(r){ return String(r.UserId) === String(userId); });
  var subj = {}, tops = {};
  rs.forEach(function(r){
    subj[r.Section] = subj[r.Section] || {answered:0, correct:0};
    subj[r.Section].answered++;
    if(String(r.IsCorrect) === 'true') subj[r.Section].correct++;
    var tk = String(r.Topic || '—') + '|' + r.Section;
    tops[tk] = tops[tk] || {answered:0, correct:0, topic:String(r.Topic || ''), section:String(r.Section)};
    tops[tk].answered++;
    if(String(r.IsCorrect) === 'true') tops[tk].correct++;
  });
  return {rs:rs, subj:subj, tops:tops};
}

function getStudentAnalytics(userId, token){
  var u = requireSession_(userId, token);
  var mine = readTab_('Attempts').filter(function(a){ return String(a.UserId) === String(u.ID); })
    .sort(function(a, b){ return new Date(a.SubmittedAt) - new Date(b.SubmittedAt); });
  var trend = mine.map(function(a){ return {at:String(a.SubmittedAt), acc:Number(a.Accuracy), score:Number(a.Score), total:Number(a.Total)}; });
  var agg = responsesAgg_(u.ID);
  var subjects = Object.keys(agg.subj).map(function(s){
    var o = agg.subj[s];
    return {section:s, answered:o.answered, acc:Math.round(o.correct / o.answered * 1000) / 10};
  }).sort(function(a, b){ return b.acc - a.acc; });
  var weakTopics = Object.keys(agg.tops).map(function(k){ return agg.tops[k]; })
    .filter(function(t){ return t.answered >= 3 && (t.correct / t.answered) < 0.7; })
    .map(function(t){
      var code = String(t.topic || '').toUpperCase();
      return {code:code, topic:(TOPICS_[t.section] && TOPICS_[t.section][code]) || t.topic || 'General',
              section:t.section, answered:t.answered, acc:Math.round(t.correct / t.answered * 1000) / 10};
    })
    .sort(function(a, b){ return a.acc - b.acc; }).slice(0, 6);
  return {trend:trend, subjects:subjects, weakTopics:weakTopics};
}

function getLeaderboard(userId, token){
  var me = requireSession_(userId, token);
  var users = readTab_('Users').filter(function(u){ return String(u.Role) === 'student' && String(u.Status) === 'approved'; });
  var attempts = readTab_('Attempts');
  var rows = users.map(function(u){
    var at = attempts.filter(function(a){ return String(a.UserId) === String(u.ID); });
    var avg = at.length ? Math.round(at.reduce(function(s, a){ return s + Number(a.Accuracy); }, 0) / at.length * 10) / 10 : 0;
    return {userId:String(u.ID), name:String(u.Name), avg:avg, attempts:at.length};
  }).filter(function(r){ return r.attempts > 0; })
    .sort(function(a, b){ return b.avg - a.avg || b.attempts - a.attempts; });
  var total = rows.length;
  var meRow = null, meRank = 0;
  for(var i = 0; i < rows.length; i++){
    if(rows[i].userId === String(me.ID)){ meRow = rows[i]; meRank = i + 1; break; }
  }
  return {rows:rows.slice(0, 10),
          me:{rank:meRank, avg:meRow ? meRow.avg : 0, total:total, isMe:true}};
}

