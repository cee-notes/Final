function getTeacherAnalytics(userId, token){
  requireSession_(userId, token, 'teacher');
  var users = readTab_('Users').filter(function(u){ return String(u.Role) === 'student' && String(u.Status) === 'approved'; });
  var attempts = readTab_('Attempts');
  var responses = readTab_('Responses');
  var rows = [], classSubj = {}, classTops = {}, totAtt = 0, totAns = 0, accSum = 0;
  users.forEach(function(u){
    var at = attempts.filter(function(a){ return String(a.UserId) === String(u.ID); });
    var rs = responses.filter(function(r){ return String(r.UserId) === String(u.ID); });
    var answered = rs.length, correct = 0, subj = {}, tops = {};
    rs.forEach(function(r){
      classSubj[r.Section] = classSubj[r.Section] || {answered:0, correct:0};
      classSubj[r.Section].answered++; totAns++;
      subj[r.Section] = subj[r.Section] || {answered:0, correct:0};
      subj[r.Section].answered++;
      tops[String(r.Topic || '—')] = tops[String(r.Topic || '—')] || {answered:0, correct:0, section:String(r.Section)};
      tops[String(r.Topic || '—')].answered++;
      var isC = String(r.IsCorrect) === 'true';
      if(isC){
        classSubj[r.Section].correct++; subj[r.Section].correct++; tops[String(r.Topic || '—')].correct++;
      }
      var tk = String(r.Topic || '—') + '|' + r.Section;
      classTops[tk] = classTops[tk] || {topic:String(r.Topic || ''), section:String(r.Section), answered:0, correct:0};
      classTops[tk].answered++;
      if(isC) classTops[tk].correct++;
      if(isC) correct++;
    });
    var weakest = null, wAcc = 2;
    Object.keys(subj).forEach(function(s){
      var acc = subj[s].correct / subj[s].answered;
      if(subj[s].answered >= 3 && acc < wAcc){ wAcc = acc; weakest = s; }
    });
    var avgAcc = answered ? Math.round(correct / answered * 1000) / 10 : 0;
    totAtt += at.length; accSum += avgAcc;
    var lastActive = '';
    at.forEach(function(a){ if(String(a.SubmittedAt) > lastActive) lastActive = String(a.SubmittedAt); });
    rows.push({userId:String(u.ID), name:String(u.Name), attempts:at.length, avgAcc:avgAcc,
      best: at.length ? Math.max.apply(null, at.map(function(a){ return Number(a.Score); })) : 0,
      answered:answered, weakest:weakest,
      weakestAcc: weakest ? Math.round(wAcc * 1000) / 10 : null,
      lastActive:lastActive});
  });
  rows.sort(function(a, b){ return b.avgAcc - a.avgAcc; });
  var subjectStats = Object.keys(classSubj).map(function(s){
    var o = classSubj[s];
    return {section:s, answered:o.answered, acc:Math.round(o.correct / o.answered * 1000) / 10};
  }).sort(function(a, b){ return b.acc - a.acc; });
  var weakTopics = Object.keys(classTops).map(function(k){ return classTops[k]; })
    .filter(function(t){ return t.answered >= 3 && t.correct / t.answered < 0.7; })
    .map(function(t){
      var code = String(t.topic || '').toUpperCase();
      return {code:code, topic:(TOPICS_[t.section] && TOPICS_[t.section][code]) || t.topic || 'General',
              section:t.section, answered:t.answered, acc:Math.round(t.correct / t.answered * 1000) / 10};
    })
    .sort(function(a, b){ return a.acc - b.acc; }).slice(0, 6);
  var active = rows.filter(function(r){ return r.attempts > 0; }).length;
  return {overview:{activeStudents:active, totalStudents:users.length,
      participation: users.length ? Math.round(active / users.length * 100) : 0,
      attempts:totAtt, avgAccuracy: rows.length ? Math.round(accSum / rows.length * 10) / 10 : 0,
      answered:totAns},
    studentRows:rows, subjectStats:subjectStats, weakTopics:weakTopics};
}

function getStudentDetail(userId, token, targetUserId){
  requireSession_(userId, token, 'teacher');
  var u = getUserById_(targetUserId);
  if(!u) throw err_('Student not found.');
  var at = readTab_('Attempts').filter(function(a){ return String(a.UserId) === String(targetUserId); })
    .sort(function(a, b){ return new Date(b.SubmittedAt) - new Date(a.SubmittedAt); });
  var agg = responsesAgg_(targetUserId);
  var answered = agg.rs.length, correct = agg.rs.filter(function(r){ return String(r.IsCorrect) === 'true'; }).length;
  var subjectStats = Object.keys(agg.subj).map(function(s){
    return {section:s, answered:agg.subj[s].answered, acc:Math.round(agg.subj[s].correct / agg.subj[s].answered * 1000) / 10};
  }).sort(function(a, b){ return b.acc - a.acc; });
  var weakTopics = Object.keys(agg.tops).map(function(k){ return agg.tops[k]; })
    .filter(function(t){ return t.answered >= 3 && t.correct / t.answered < 0.7; })
    .map(function(t){
      var code = String(t.topic || '').toUpperCase();
      return {code:code, topic:(TOPICS_[t.section] && TOPICS_[t.section][code]) || t.topic || 'General',
              section:t.section, answered:t.answered, acc:Math.round(t.correct / t.answered * 1000) / 10};
    });
  return {profile:{id:String(u.ID), name:String(u.Name), email:String(u.Email), username:String(u.Username),
                   status:String(u.Status), createdAt:String(u.CreatedAt)},
    stats:{attempts:at.length, avgAcc: answered ? Math.round(correct / answered * 1000) / 10 : 0,
           best: at.length ? Math.max.apply(null, at.map(function(a){ return Number(a.Score); })) : 0,
           answered:answered},
    subjectStats:subjectStats, weakTopics:weakTopics,
    attempts:at.slice(0, 12).map(function(a){
      return {id:String(a.ID), at:String(a.SubmittedAt), type:String(a.Mode), score:Number(a.Score),
              total:Number(a.Total), correct:Number(a.Correct), wrong:Number(a.Wrong),
              skipped:Number(a.Skipped), accuracy:Number(a.Accuracy)};
    })};
}

function sendStudentEmail(userId, token, targetUserId, message){
