  try{ sh.setTabColor('#fbbf24'); }catch(e){}
  var url = '';
  try{ url = ScriptApp.getService().getUrl() || ''; }catch(e){}
  var rows = [
    ['🎓 CEE MOCK PORTAL — ADMIN DASHBOARD', ''],
    ['Web app', url || 'Deploy as a web app (Deploy → New deployment → Web app), then 🎓 CEE Portal → 📊 Refresh dashboard'],
    ['Sheet updated', nowISO_()],
    ['', ''],
    ['PEOPLE', ''],
    ['Total users', '=COUNTA(Users!A2:A)'],
    ['Students', '=COUNTIF(Users!F:F,"student")'],
    ['Teachers', '=COUNTIF(Users!F:F,"teacher")'],
    ['Pending registrations', '=COUNTIF(Users!G:G,"pending")'],
    ['Approved', '=COUNTIF(Users!G:G,"approved")'],
    ['Rejected', '=COUNTIF(Users!G:G,"rejected")'],
    ['', ''],
    ['CONTENT', ''],
    ['Questions in bank', '=COUNTA(Questions!A2:A)'],
    ['Difficulty — easy / medium / hard', '=COUNTIF(Questions!L:L,"easy")&" / "&COUNTIF(Questions!L:L,"medium")&" / "&COUNTIF(Questions!L:L,"hard")'],
    ['Exam attempts (all time)', '=COUNTA(Attempts!A2:A)'],
    ['Model-exam attempts today', '=COUNTIF(Attempts!J:J,TEXT(TODAY(),"yyyy-mm-dd"))'],
    ['Daily papers stored', '=COUNTA(DailyExams!A2:A)'],
    ['Unread student messages', '=COUNTIF(Messages!F:F,"false")'],
    ['', ''],
    ['HOW TO USE THIS SHEET', ''],
    ['Approve / reject a registration', 'Edit the Status cell (column G) in the Users tab — pending / approved / rejected. To email the student automatically when you do, run 🎓 CEE Portal → ⚡ Toggle auto-respond to sheet edits once.'],
    ['Register a student directly', '🎓 CEE Portal → 📋 Register a student… creates an approved account and emails them the sign-in details.'],
    ['Model exam of the day', '🎓 CEE Portal → 📅 Generate today\u2019s model exam, or ⏰ autopilot to prepare each day\u2019s paper at 20:00 script time.'],
    ['Your notes', 'Users column L (Notes) is yours — fees, class, remarks. The portal ignores it.'],
    ['Managed by the portal', 'PassHash / SessionToken / SessionExpires (hidden) and all ID columns — please don\u2019t type into them.'],
    ['Live counts', 'Every number above is a formula — it updates the moment the portal writes data.']
