/* ============================================================================
   SHEET CORE — tabs, headers, read/write helpers
   ============================================================================ */
var TAB_SCHEMA_ = {
  Users:     ['ID','Name','Email','Username','PassHash','Role','Status','CreatedAt','DeviceId','SessionToken','SessionExpires'],
  Questions: ['ID','Text','OptA','OptB','OptC','OptD','Answer','Section','Topic','Explanation','Image','CreatedAt','UpdatedAt'],
  Attempts:  ['ID','AttemptIndex','UserId','StartedAt','SubmittedAt','DurMin','Deadline','Section','Mode','NegMarking','Score','Total','Correct','Wrong','Skipped','Accuracy','AutoSubmitted','Late'],
  Responses: ['ID','AttemptId','UserId','QId','QuestionText','Chosen','IsCorrect','Section','Topic'],
  Messages:  ['ID','FromUserId','FromName','Message','CreatedAt','Read']
};

function SS_(){ return SpreadsheetApp.getActiveSpreadsheet(); }

function getTab_(name){
  var ss = SS_();
  var sh = ss.getSheetByName(name);
  if(!sh){
    sh = ss.insertSheet(name);
    sh.getRange(1, 1, 1, TAB_SCHEMA_[name].length).setValues([TAB_SCHEMA_[name]])
      .setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

/* Sheets re-interprets leading '=', '+', '-', apostrophes and date-like text;
   every string cell is written apostrophe-prefixed and stripped on read. */
function escCell_(v){
  if(v == null) return '';
  return "'" + String(v);
}
function stripCell_(v){
  if(v == null) return '';
  return String(v).replace(/^'/, '');
}

function readTab_(name){
  var sh = getTab_(name);
  var rng = sh.getDataRange();
  var vals = rng.getValues();
  if(vals.length < 2) return [];
  var head = vals[0].map(function(h){ return String(h).replace(/^'/,''); });
  var out = [];
  for(var r = 1; r < vals.length; r++){
    if(vals[r].join('') === '') continue;
    var o = {_row: r + 1};
    for(var c = 0; c < head.length; c++){
      var v = vals[r][c];
      o[head[c]] = (v instanceof Date) ? v.toISOString() : (typeof v === 'string' ? stripCell_(v) : v);
    }
    out.push(o);
  }
  return out;
}

function appendObj_(name, obj){
  var sh = getTab_(name);
  var head = TAB_SCHEMA_[name];
  var row = head.map(function(h){
    var v = obj[h];
    if(v == null) return '';
    return (typeof v === 'string') ? escCell_(v) : v;
  });
  sh.getRange(sh.getLastRow() + 1, 1, 1, row.length).setValues([row]);
}

function findRowById_(name, id){
  var rows = readTab_(name);
  for(var i = 0; i < rows.length; i++){
    if(String(rows[i].ID) === String(id)) return rows[i];
  }
  return null;
}

function patchRow_(name, rowNum, patch){
  var sh = getTab_(name);
  var head = TAB_SCHEMA_[name];
  var row = sh.getRange(rowNum, 1, 1, head.length).getValues()[0];
  for(var c = 0; c < head.length; c++){
    if(patch.hasOwnProperty(head[c])){
      var v = patch[head[c]];
      row[c] = (typeof v === 'string') ? escCell_(v) : (v == null ? '' : v);
    }
  }
  sh.getRange(rowNum, 1, 1, head.length).setValues([row]);
}

function deleteRowById_(name, id){
  var row = findRowById_(name, id);
  if(!row) return false;
  getTab_(name).deleteRow(row._row);
  return true;
}

/* ============================================================================
   GENERAL UTILITIES
   ============================================================================ */
function nowISO_(){ return new Date().toISOString(); }

/* ============================================================================
   ID GENERATION HELPERS - Custom formats per entity type
   ========================================================================== */
function getNextQuestionId_(section){
  var sh = getTab_('Questions');
  var lastRow = sh.getLastRow();
  if(lastRow < 2) return getInitialQuestionId_(section);
  
  var prefix = getQuestionPrefix_(section);
  var allIds = sh.getRange(2, 1, lastRow - 1, 1).getValues().map(function(r){ return String(r[0]); });
  var maxNum = 0;
  for(var i = 0; i < allIds.length; i++){
    var id = allIds[i];
    if(id.indexOf(prefix) === 0){
      var numStr = id.substring(prefix.length);
      var num = parseInt(numStr, 10);
      if(!isNaN(num) && num > maxNum) maxNum = num;
    }
  }
  return prefix + padNumber_(maxNum + 1, 4);
}

function getQuestionPrefix_(section){
  var sec = String(section || '').toUpperCase();
  if(sec.indexOf('PHYS') >= 0 || sec === 'P' || sec === 'P1' || sec === 'P2' || sec === 'P3' || sec === 'P4') return 'QP-';
  if(sec.indexOf('CHEM') >= 0 || sec === 'C' || sec === 'C1' || sec === 'C2' || sec === 'C3' || sec === 'C4' || sec === 'C5') return 'QC-';
  if(sec.indexOf('BIOL') >= 0 || sec === 'B' || sec === 'BOTANY' || sec === 'ZOOLOGY' || sec === 'Z1' || sec === 'Z2' || sec === 'Z3' || sec === 'B1' || sec === 'B2' || sec === 'B3') return 'QB-';
  if(sec.indexOf('ENG') >= 0 || sec === 'E' || sec === 'ENGLISH') return 'QE-';
  return 'Q-';
}

function getNextStudentId_(){
  var sh = getTab_('Users');
  var lastRow = sh.getLastRow();
  if(lastRow < 2) return 'S-20010';
  
  var allIds = sh.getRange(2, 1, lastRow - 1, 1).getValues().map(function(r){ return String(r[0]); });
  var maxNum = 20009;
  for(var i = 0; i < allIds.length; i++){
    var id = allIds[i];
    if(id.indexOf('S-') === 0){
      var numStr = id.substring(2);
      var num = parseInt(numStr, 10);
      if(!isNaN(num) && num > maxNum) maxNum = num;
    }
  }
  return 'S-' + (maxNum + 1);
}

function getNextTeacherId_(){
  var sh = getTab_('Users');
  var lastRow = sh.getLastRow();
  if(lastRow < 2) return 'T-001';
  
  var allIds = sh.getRange(2, 1, lastRow - 1, 1).getValues().map(function(r){ return String(r[0]); });
  var maxNum = 0;
  for(var i = 0; i < allIds.length; i++){
    var id = allIds[i];
    if(id.indexOf('T-') === 0){
      var numStr = id.substring(2);
      var num = parseInt(numStr, 10);
      if(!isNaN(num) && num > maxNum) maxNum = num;
    }
  }
  return 'T-' + padNumber_(maxNum + 1, 3);
}

function getInitialQuestionId_(section){
  var prefix = getQuestionPrefix_(section);
  return prefix + '0001';
}

function padNumber_(num, digits){
  var str = String(num);
  while(str.length < digits) str = '0' + str;
  return str;
}

function uid_(){ return Utilities.getUuid(); }

function err_(msg, code){
  var e = new Error(msg);
  if(code) e.code = code;
  return e;
}

/** Public per project brief: SHA-256 password hash (hex). */
function hashPassword(pw){
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(pw), Utilities.Charset.UTF_8);
  return bytes.map(function(b){
    var h = (b < 0 ? b + 256 : b).toString(16);
    return h.length === 1 ? '0' + h : h;
  }).join('');
}

/** Public per project brief: random in-place shuffle (returns a copy). */
function shuffleArray(arr){
  var out = arr.slice();
  for(var i = out.length - 1; i > 0; i--){
    var j = Math.floor(Math.random() * (i + 1));
    var t = out[i]; out[i] = out[j]; out[j] = t;
  }
  return out;
}

function norm_(s){
  return String(s == null ? '' : s).toLowerCase().replace(/\s+/g, ' ').trim();
}

function strSeed_(str){
  var h = 2166136261;
  str = String(str || '');
  for(var i = 0; i < str.length; i++){
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function mulberry32_(a){
  return function(){
    a |= 0; a = a + 0x6D2B79F5 | 0;
    var t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}

function seededShuffle_(arr, seed){
  var out = arr.slice(), rnd = mulberry32_(seed), i, j, t;
  for(i = out.length - 1; i > 0; i--){
    j = Math.floor(rnd() * (i + 1));
    t = out[i]; out[i] = out[j]; out[j] = t;
  }
  return out;
}

/* ============================================================================
   EXAM-OPTION MATHS (1:1 with the client twins in the embedded frontend)
   ============================================================================ */
var SECTIONS_ = ['Physics','Chemistry','Biology','Botany','Maths'];
var TOPICS_ = {
  Physics:{P1:'Mechanics',P2:'Heat & Thermodynamics',P3:'Waves & Optics',P4:'Electricity & Magnetism',P5:'Modern Physics',P6:'Electronics',P7:'Units & Measurements',P8:'Vector & Kinematics'},
  Chemistry:{C1:'Atomic Structure',C2:'Chemical Bonding',C3:'Stoichiometry',C4:'Thermodynamics',C5:'Organic Chemistry',C6:'Acids & Bases',C7:'Periodic Table'},
  Biology:{Z1:'Human Physiology',Z2:'Cell Biology',Z3:'Genetics',Z4:'Human Diseases',Z5:'Ecology',Z6:'Evolution',Z7:'Animal Behavior',Z8:'Circulatory System',Z9:'Respiratory System'},
  Botany:{B1:'Plant Anatomy',B2:'Plant Physiology',B3:'Photosynthesis',B4:'Plant Ecology',B5:'Plant Reproduction',B6:'Economic Botany'},
  Maths:{M1:'Algebra',M2:'Trigonometry',M3:'Calculus',M4:'Geometry',M5:'Probability',M6:'Statistics',M7:'Sets & Functions',M8:'Matrices',M9:'Coordinate Geometry'}
};

function normalizeExamOptions_(o){
  o = o || {};
  var mode = (o.mode === 'practice') ? 'practice' : 'mock';
  var subs = Object.prototype.toString.call(o.subjects) === '[object Array]'
    ? o.subjects.filter(function(s){ return SECTIONS_.indexOf(s) >= 0; }) : [];
  subs = subs.filter(function(s, i){ return subs.indexOf(s) === i; }).sort();
  var tops = Object.prototype.toString.call(o.topics) === '[object Array]'
    ? o.topics.map(function(t){ return String(t || '').toUpperCase(); })
      .filter(function(t){
        return Object.keys(TOPICS_).some(function(sec){ return TOPICS_[sec][t]; });
      }) : [];
  tops = tops.filter(function(t, i){ return tops.indexOf(t) === i; }).sort();
  var count = Math.max(0, Math.min(200, parseInt(o.count, 10) || 0));
  var timed = mode === 'mock' ? true : !!o.timed;
  /* mock duration is 0 = "auto": derived from the paper the bank can actually fill */
  var dur = 0;
  if(mode !== 'mock'){
    dur = Math.max(0, Math.min(240, parseInt(o.durationMinutes, 10) || 0));
    if(timed && dur === 0) dur = 60;
  }
  var neg = mode === 'mock' ? true : !!o.negMarking;
  var ifb = mode === 'practice' ? !!o.ifb : false;
  return {mode:mode, subjects:subs, topics:tops, count:count, timed:timed, durationMinutes:dur, negMarking:neg, ifb:ifb};
}

function examOptsSignature_(o){
  return ['v1', o.mode, o.subjects.join('+'), o.topics.join('+'), o.count,
          o.timed ? 1 : 0, o.durationMinutes, o.negMarking ? 1 : 0, o.ifb ? 1 : 0].join('|');
}

function filterBankForPractice_(bank, opts){
  if(opts.mode !== 'practice') return bank;
  return bank.filter(function(q){
    if(opts.subjects.length && opts.subjects.indexOf(q.section) < 0) return false;
    if(opts.topics.length && opts.topics.indexOf(String(q.topic || '').toUpperCase()) < 0) return false;
    return true;
  });
}

/* ---------- MEC CEE bachelor-level paper blueprint ----------
   Official pattern: 200 MCQs / 180 minutes / +1 / -0.25.
   Physics 25%, Chemistry 25%, Biology 40% (zoology + botany), MAT 10%.
   KEEP IN SYNC with the identical block in index.html — the client shows the
   paper this builds and the server rebuilds it again when scoring.            */
var CEE_BLUEPRINT_ = [
  {section:'Physics',   n:50},
  {section:'Chemistry', n:50},
  {section:'Biology',   n:40},
  {section:'Botany',    n:40},
  {section:'Maths',     n:20}
];
var CEE_TOTAL_Q_ = 200, CEE_MIN_PER_Q_ = 0.9, CEE_MIN_MINUTES_ = 10, CEE_MAX_MINUTES_ = 240;

function ceeDurationFor_(n){
  return Math.max(CEE_MIN_MINUTES_, Math.min(CEE_MAX_MINUTES_, Math.round((n || 0) * CEE_MIN_PER_Q_)));
}

function buildCeeMockSet_(bank, seed){
  var bySection = {};
  bank.forEach(function(q){
    var s = q.section;
    if(!bySection[s]) bySection[s] = [];
    bySection[s].push(q);
  });
  var takes = [], rest = [];
  CEE_BLUEPRINT_.forEach(function(b, i){
    var pool = seededShuffle_(bySection[b.section] || [], seed + i * 7919);
    takes.push(pool.slice(0, b.n));
    pool.slice(b.n).forEach(function(q){ rest.push(q); });
  });
  var picked = takes.reduce(function(n, t){ return n + t.length; }, 0);
  if(picked < CEE_TOTAL_Q_ && rest.length){
    var fill = seededShuffle_(rest, seed + 104729).slice(0, CEE_TOTAL_Q_ - picked);
    fill.forEach(function(q){
      for(var i = 0; i < CEE_BLUEPRINT_.length; i++){
        if(CEE_BLUEPRINT_[i].section === q.section){ takes[i].push(q); return; }
      }
      takes[0].push(q);
    });
  }
  var out = [];
  takes.forEach(function(t){ out = out.concat(t); });
  return out;
}

function buildExamSet_(bank, opts, seed){
  if(opts.mode === 'mock') return buildCeeMockSet_(bank, seed);
  var pool = filterBankForPractice_(bank, opts);
  var set = seededShuffle_(pool, seed);
  if(opts.count > 0) set = set.slice(0, Math.min(opts.count, set.length));
  return set;
}

function scoreItem_(q, chosen, neg){
  if(chosen == null || chosen < 0) return {state:'skipped', pts:0};
  if(parseInt(chosen, 10) === parseInt(q.answer, 10)) return {state:'correct', pts:1};
  return {state:'wrong', pts: neg ? -0.25 : 0};
}

