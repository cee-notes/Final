function getInbox(userId, token){
  var u = requireSession_(userId, token);
  var isTeacher = String(u.Role) === 'teacher';
  var users = readTab_('Users');
  var byId = {};
  users.forEach(function(x){ byId[String(x.ID)] = x; });
  var rows = readTab_('Messages').filter(function(m){
    return isTeacher ? true : String(m.FromUserId) === String(u.ID);
  }).sort(function(a, b){ return new Date(b.CreatedAt) - new Date(a.CreatedAt); });
  var unread = 0;
  var messages = rows.map(function(m){
