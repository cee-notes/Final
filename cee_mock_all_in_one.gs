/* ============================================================================
   SHEET CORE — tabs, headers, read/write helpers
   ============================================================================ */
var TAB_SCHEMA_ = {
  Users:     ['ID','Name','Email','Username','PassHash','Role','Status','CreatedAt','DeviceId','SessionToken','SessionExpires'],
  Questions: ['ID','Text','OptA','OptB','OptC','OptD','Answer','Section','Topic','Explanation','Image','CreatedAt','UpdatedAt'],
  Attempts:  ['ID','AttemptIndex','UserId','StartedAt','SubmittedAt','DurMin','Deadline','Section','Mode','NegMarking','Score','Total','Correct','Wrong','Skipped','Accuracy','AutoSubmitted','Late'],
  Responses: ['ID','AttemptId','UserId','QId','QuestionText','Chosen','IsCorrect','Section','Topic'],
  Messages:  ['ID','FromUserId','FromName','Message','CreatedAt','Read']
};

function SS_(){ return SpreadsheetApp.getActiveSpreadsheet(); }

function getTab_(name){
  var ss = SS_();
  var sh = ss.getSheetByName(name);
  if(!sh){
    sh = ss.insertSheet(name);
    sh.getRange(1, 1, 1, TAB_SCHEMA_[name].length).setValues([TAB_SCHEMA_[name]])
      .setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

/* Sheets re-interprets leading '=', '+', '-', apostrophes and date-like text;
   every string cell is written apostrophe-prefixed and stripped on read. */
function escCell_(v){
  if(v == null) return '';
  return "'" + String(v);
}
function stripCell_(v){
  if(v == null) return '';
  return String(v).replace(/^'/, '');
}

function readTab_(name){
  var sh = getTab_(name);
  var rng = sh.getDataRange();
  var vals = rng.getValues();
  if(vals.length < 2) return [];
  var head = vals[0].map(function(h){ return String(h).replace(/^'/,''); });
  var out = [];
  for(var r = 1; r < vals.length; r++){
    if(vals[r].join('') === '') continue;
    var o = {_row: r + 1};
    for(var c = 0; c < head.length; c++){
      var v = vals[r][c];
      o[head[c]] = (v instanceof Date) ? v.toISOString() : (typeof v === 'string' ? stripCell_(v) : v);
    }
    out.push(o);
  }
  return out;
}

function appendObj_(name, obj){
  var sh = getTab_(name);
  var head = TAB_SCHEMA_[name];
  var row = head.map(function(h){
    var v = obj[h];
    if(v == null) return '';
    return (typeof v === 'string') ? escCell_(v) : v;
  });
  sh.getRange(sh.getLastRow() + 1, 1, 1, row.length).setValues([row]);
}

function findRowById_(name, id){
  var rows = readTab_(name);
  for(var i = 0; i < rows.length; i++){
    if(String(rows[i].ID) === String(id)) return rows[i];
  }
  return null;
}

function patchRow_(name, rowNum, patch){
  var sh = getTab_(name);
  var head = TAB_SCHEMA_[name];
  var row = sh.getRange(rowNum, 1, 1, head.length).getValues()[0];
  for(var c = 0; c < head.length; c++){
    if(patch.hasOwnProperty(head[c])){
      var v = patch[head[c]];
      row[c] = (typeof v === 'string') ? escCell_(v) : (v == null ? '' : v);
    }
  }
  sh.getRange(rowNum, 1, 1, head.length).setValues([row]);
}

function deleteRowById_(name, id){
  var row = findRowById_(name, id);
  if(!row) return false;
  getTab_(name).deleteRow(row._row);
  return true;
}

/* ============================================================================
   GENERAL UTILITIES
   ============================================================================ */
function nowISO_(){ return new Date().toISOString(); }

function uid_(){ return Utilities.getUuid(); }

function err_(msg, code){
  var e = new Error(msg);
  if(code) e.code = code;
  return e;
}

/** Public per project brief: SHA-256 password hash (hex). */
function hashPassword(pw){
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(pw), Utilities.Charset.UTF_8);
  return bytes.map(function(b){
    var h = (b < 0 ? b + 256 : b).toString(16);
    return h.length === 1 ? '0' + h : h;
  }).join('');
}

/** Public per project brief: random in-place shuffle (returns a copy). */
function shuffleArray(arr){
  var out = arr.slice();
  for(var i = out.length - 1; i > 0; i--){
    var j = Math.floor(Math.random() * (i + 1));
    var t = out[i]; out[i] = out[j]; out[j] = t;
  }
  return out;
}

function norm_(s){
  return String(s == null ? '' : s).toLowerCase().replace(/\s+/g, ' ').trim();
}

function strSeed_(str){
  var h = 2166136261;
  str = String(str || '');
  for(var i = 0; i < str.length; i++){
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function mulberry32_(a){
  return function(){
    a |= 0; a = a + 0x6D2B79F5 | 0;
    var t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}

function seededShuffle_(arr, seed){
  var out = arr.slice(), rnd = mulberry32_(seed), i, j, t;
  for(i = out.length - 1; i > 0; i--){
    j = Math.floor(rnd() * (i + 1));
    t = out[i]; out[i] = out[j]; out[j] = t;
  }
  return out;
}

/* ============================================================================
   EXAM-OPTION MATHS (1:1 with the client twins in the embedded frontend)
   ============================================================================ */
var SECTIONS_ = ['Physics','Chemistry','Biology','Botany','Maths'];
var TOPICS_ = {
  Physics:{P1:'Mechanics',P2:'Heat & Thermodynamics',P3:'Waves & Optics',P4:'Electricity & Magnetism',P5:'Modern Physics',P6:'Electronics',P7:'Units & Measurements',P8:'Vector & Kinematics'},
  Chemistry:{C1:'Atomic Structure',C2:'Chemical Bonding',C3:'Stoichiometry',C4:'Thermodynamics',C5:'Organic Chemistry',C6:'Acids & Bases',C7:'Periodic Table'},
  Biology:{Z1:'Human Physiology',Z2:'Cell Biology',Z3:'Genetics',Z4:'Human Diseases',Z5:'Ecology',Z6:'Evolution',Z7:'Animal Behavior',Z8:'Circulatory System',Z9:'Respiratory System'},
  Botany:{B1:'Plant Anatomy',B2:'Plant Physiology',B3:'Photosynthesis',B4:'Plant Ecology',B5:'Plant Reproduction',B6:'Economic Botany'},
  Maths:{M1:'Algebra',M2:'Trigonometry',M3:'Calculus',M4:'Geometry',M5:'Probability',M6:'Statistics',M7:'Sets & Functions',M8:'Matrices',M9:'Coordinate Geometry'}
};

function normalizeExamOptions_(o){
  o = o || {};
  var mode = (o.mode === 'practice') ? 'practice' : 'mock';
  var subs = Object.prototype.toString.call(o.subjects) === '[object Array]'
    ? o.subjects.filter(function(s){ return SECTIONS_.indexOf(s) >= 0; }) : [];
  subs = subs.filter(function(s, i){ return subs.indexOf(s) === i; }).sort();
  var tops = Object.prototype.toString.call(o.topics) === '[object Array]'
    ? o.topics.map(function(t){ return String(t || '').toUpperCase(); })
      .filter(function(t){
        return Object.keys(TOPICS_).some(function(sec){ return TOPICS_[sec][t]; });
      }) : [];
  tops = tops.filter(function(t, i){ return tops.indexOf(t) === i; }).sort();
  var count = Math.max(0, Math.min(200, parseInt(o.count, 10) || 0));
  var timed = mode === 'mock' ? true : !!o.timed;
  var dur = mode === 'mock' ? 60 : Math.max(0, Math.min(240, parseInt(o.durationMinutes, 10) || 0));
  if(timed && dur === 0) dur = 60;
  var neg = mode === 'mock' ? true : !!o.negMarking;
  var ifb = mode === 'practice' ? !!o.ifb : false;
  return {mode:mode, subjects:subs, topics:tops, count:count, timed:timed, durationMinutes:dur, negMarking:neg, ifb:ifb};
}

function examOptsSignature_(o){
  return ['v1', o.mode, o.subjects.join('+'), o.topics.join('+'), o.count,
          o.timed ? 1 : 0, o.durationMinutes, o.negMarking ? 1 : 0, o.ifb ? 1 : 0].join('|');
}

function filterBankForPractice_(bank, opts){
  if(opts.mode !== 'practice') return bank;
  return bank.filter(function(q){
    if(opts.subjects.length && opts.subjects.indexOf(q.section) < 0) return false;
    if(opts.topics.length && opts.topics.indexOf(String(q.topic || '').toUpperCase()) < 0) return false;
    return true;
  });
}

function buildExamSet_(bank, opts, seed){
  var pool = filterBankForPractice_(bank, opts);
  var set = seededShuffle_(pool, seed);
  if(opts.mode === 'practice' && opts.count > 0) set = set.slice(0, Math.min(opts.count, set.length));
  return set;
}

function scoreItem_(q, chosen, neg){
  if(chosen == null || chosen < 0) return {state:'skipped', pts:0};
  if(parseInt(chosen, 10) === parseInt(q.answer, 10)) return {state:'correct', pts:1};
  return {state:'wrong', pts: neg ? -0.25 : 0};
}

/* ============================================================================
   SESSIONS / AUTH
   ============================================================================ */
function getUserById_(id){
  return findRowById_('Users', id);
}
function getUserByEmail_(email){
  email = String(email || '').toLowerCase().trim();
  var rows = readTab_('Users');
  for(var i = 0; i < rows.length; i++){
    if(String(rows[i].Email).toLowerCase() === email) return rows[i];
  }
  return null;
}
function pubUser_(u){
  return {id:String(u.ID), name:String(u.Name), email:String(u.Email), username:String(u.Username),
          role:String(u.Role), status:String(u.Status), createdAt:String(u.CreatedAt),
          hasDevice:!!u.DeviceId};
}
/** Validates the session token; role (optional) must match. Throws on failure. */
function requireSession_(userId, token, role){
  var u = getUserById_(userId);
  if(!u || !u.SessionToken || String(u.SessionToken) !== String(token)) throw err_('Session expired. Please sign in again.', 'NO_SESSION');
  if(u.SessionExpires && new Date(stripCell_(u.SessionExpires)) < new Date()) throw err_('Session expired. Please sign in again.', 'NO_SESSION');
  if(role && String(u.Role) !== role) throw err_('You do not have permission to do that.', 'FORBIDDEN');
  return u;
}

function loginRateLimitOk_(email){
  var cache = CacheService.getScriptCache();
  if(cache.get('lock_' + email)) return false;
  return true;
}
function loginRateFail_(email){
  var cache = CacheService.getScriptCache();
  var n = parseInt(cache.get('rl_' + email) || '0', 10) + 1;
  if(n >= 5){ cache.put('lock_' + email, '1', 120); cache.remove('rl_' + email); }
  else cache.put('rl_' + email, String(n), 600);
}
function loginRateClear_(email){
  var cache = CacheService.getScriptCache();
  cache.remove('rl_' + email);
  cache.remove('lock_' + email);
}

/* ============================================================================
   PUBLIC API — AUTH
   ============================================================================ */
function register(name, email, username, password){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    name = String(name || '').trim();
    email = String(email || '').toLowerCase().trim();
    username = String(username || '').toLowerCase().trim();
    if(name.length < 2) throw err_('Please enter your full name.');
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw err_('Please enter a valid email address.');
    if(username.length < 3 || !/^[a-z0-9_.]+$/.test(username)) throw err_('Username must be 3+ characters (letters, numbers, dot or underscore).');
    if(String(password || '').length < 6) throw err_('Password must be at least 6 characters.');
    if(getUserByEmail_(email)) throw err_('An account with this email already exists.');
    if(readTab_('Users').some(function(u){ return String(u.Username) === username; })) throw err_('This username is already taken.');
    var u = {ID:'u-' + uid_(), Name:name, Email:email, Username:username,
             PassHash:hashPassword(password), Role:'student', Status:'pending',
             CreatedAt:nowISO_(), DeviceId:'', SessionToken:'', SessionExpires:''};
    appendObj_('Users', u);
    emailNewRegistration_(u);
    return {ok:true, message:'Registration submitted. You can sign in once a teacher approves your account.'};
  } finally {
    lock.releaseLock();
  }
}

function login(email, password, deviceId){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    email = String(email || '').toLowerCase().trim();
    if(!loginRateLimitOk_(email)){
      throw err_('Too many failed attempts. Try again in 2 minutes.', 'TOO_MANY_ATTEMPTS');
    }
    var u = getUserByEmail_(email);
    if(!u || String(u.PassHash) !== hashPassword(String(password || ''))){
      loginRateFail_(email);
      var cache = CacheService.getScriptCache();
      throw err_(cache.get('lock_' + email) ? 'Too many failed attempts. Locked for 2 minutes.' : 'Incorrect email or password.',
                 cache.get('lock_' + email) ? 'TOO_MANY_ATTEMPTS' : 'BAD_LOGIN');
    }
    loginRateClear_(email);
    if(u.Status === 'pending') throw err_('Your account is awaiting teacher approval. You will be notified by email.', 'PENDING');
    if(u.Status === 'rejected') throw err_('Your registration was not approved. Please contact your teacher.', 'REJECTED');
    if(u.DeviceId && String(u.DeviceId) !== String(deviceId || '')){
      throw err_('This account is bound to another device. Ask a teacher to reset your device.', 'DEVICE_LOCKED');
    }
    var token = uid_();
    patchRow_('Users', u._row, {DeviceId:String(deviceId || ''), SessionToken:token,
                                SessionExpires:new Date(Date.now() + 86400000).toISOString()});
    return {user:pubUser_(u), token:token};
  } finally {
    lock.releaseLock();
  }
}

function logout(userId, token){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    var u = getUserById_(userId);
    if(u && u.SessionToken && String(u.SessionToken) === String(token || '')){
      patchRow_('Users', u._row, {SessionToken:'', SessionExpires:''});
    }
    return {ok:true};
  } finally {
    lock.releaseLock();
  }
}

function restoreSession(userId, token){
  try{
    var u = requireSession_(userId, token);
    return {ok:true, user:pubUser_(u), token:token};
  }catch(e){
    return {ok:false};
  }
}

function changePassword(userId, token, oldPw, newPw){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    var u = requireSession_(userId, token);
    if(String(u.PassHash) !== hashPassword(String(oldPw || ''))) throw err_('Current password is incorrect.');
    if(String(newPw || '').length < 6) throw err_('New password must be at least 6 characters.');
    if(String(newPw) === String(oldPw)) throw err_('New password must differ from the current one.');
    patchRow_('Users', u._row, {PassHash:hashPassword(newPw)});
    sendMailSafe_(String(u.Email), 'CEE Portal — password changed',
      'Hi ' + escHtml_(u.Name) + ',<br><br>Your account password was just changed. If this was not you, contact your teacher immediately.');
    return {ok:true, message:'Password updated. A confirmation email was sent.'};
  } finally {
    lock.releaseLock();
  }
}

function approve(userId, token, targetId){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    requireSession_(userId, token, 'teacher');
    var u = getUserById_(targetId);
    if(!u) throw err_('User not found.');
    patchRow_('Users', u._row, {Status:'approved'});
    sendMailSafe_(String(u.Email), 'CEE Portal — account approved',
      'Hi ' + escHtml_(u.Name) + ',<br><br>Good news! Your account has been approved. You can now sign in and start practising.<br><br>— CEE Mock Portal');
    return {ok:true, message:String(u.Name) + ' approved.'};
  } finally {
    lock.releaseLock();
  }
}

function reject(userId, token, targetId){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    requireSession_(userId, token, 'teacher');
    var u = getUserById_(targetId);
    if(!u) throw err_('User not found.');
    patchRow_('Users', u._row, {Status:'rejected'});
    sendMailSafe_(String(u.Email), 'CEE Portal — registration not approved',
      'Hi ' + escHtml_(u.Name) + ',<br><br>We could not approve your registration at this time. Please contact your teacher for details.<br><br>— CEE Mock Portal');
    return {ok:true, message:String(u.Name) + ' rejected.'};
  } finally {
    lock.releaseLock();
  }
}

function resetDevice(userId, token, targetId){
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    requireSession_(userId, token, 'teacher');
    var u = getUserById_(targetId);
    if(!u) throw err_('User not found.');
    patchRow_('Users', u._row, {DeviceId:'', SessionToken:'', SessionExpires:''});
    return {ok:true, message:'Device lock cleared for ' + String(u.Name) + '.'};
  } finally {
    lock.releaseLock();
  }
}

/* ============================================================================
   PUBLIC API — EXAMS
   ============================================================================ */
var EXAM_META_KEY_ = 'CEE_EXAM_META_';

function startMockExam(userId, token, options){
  var u = requireSession_(userId, token);
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    var opts = normalizeExamOptions_(options);
    var bank = bank_();
    if(!bank.length) throw err_('The question bank is empty. Please ask your teacher to add questions.', 'EMPTY_BANK');
    var attempts = readTab_('Attempts');
    var attemptIndex = attempts.filter(function(a){ return String(a.UserId) === String(u.ID); }).length + 1;
    var startedAt = nowISO_();
    var sig = examOptsSignature_(opts);
    var seedKey = strSeed_(String(u.ID) + '|' + startedAt + '|' + sig);
    var set = buildExamSet_(bank, opts, seedKey);
    if(!set.length) throw err_('No questions match the selected subjects/topics. Try widening your filter.', 'EMPTY_FILTER');
    var durMin = opts.timed ? opts.durationMinutes : 0;
    var deadline = opts.timed ? new Date(Date.now() + durMin * 60000).toISOString() : '';
    PropertiesService.getScriptProperties().setProperty(EXAM_META_KEY_ + u.ID,
      JSON.stringify({start:startedAt, dur:durMin, opts:opts, sig:sig, attemptIndex:attemptIndex}));
    var qs = set.map(function(q){
      var out = {id:String(q.id), text:String(q.text), opts:[String(q.opts[0]),String(q.opts[1]),String(q.opts[2]),String(q.opts[3])],
                 section:String(q.section), topic:String(q.topic || ''), img:String(q.img || '')};
      if(opts.ifb){ out.answer = parseInt(q.answer, 10); out.explanation = String(q.explanation || ''); }
      return out;
    });
    return {attemptIndex:attemptIndex, startedAt:startedAt, durMin:durMin, deadline:deadline,
            opts:opts, questions:qs};
  } finally {
    lock.releaseLock();
  }
}

function submitExam(userId, token, data){
  var u = requireSession_(userId, token);
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    data = data || {};
    var attemptIndex = data.attemptIndex != null ? data.attemptIndex : null;
    /* --- idempotency: matching stored attempt returned as-is (meta untouched) --- */
    var attempts = readTab_('Attempts');
    var existing = null;
    for(var i = 0; i < attempts.length; i++){
      if(String(attempts[i].UserId) === String(u.ID) && String(attempts[i].AttemptIndex) === String(attemptIndex)){ existing = attempts[i]; break; }
    }
    if(existing){
      return {duplicate:true, id:String(existing.ID), score:Number(existing.Score), total:Number(existing.Total),
              correct:Number(existing.Correct), wrong:Number(existing.Wrong), skipped:Number(existing.Skipped),
              accuracy:Number(existing.Accuracy), section:String(existing.Section), mode:String(existing.Mode),
              negMarking:String(existing.Mode) !== 'practice', autoSubmitted:String(existing.AutoSubmitted) === 'true',
              late:String(existing.Late) === 'true'};
    }
    /* --- authoritative options come from the stored meta only --- */
    var props = PropertiesService.getScriptProperties();
    var meta = null;
    var rawMeta = props.getProperty(EXAM_META_KEY_ + u.ID);
    if(rawMeta){
      try{ meta = JSON.parse(rawMeta); }catch(e){ meta = null; }
    }
    var opts, startedAt;
    if(meta && meta.attemptIndex != null && String(meta.attemptIndex) === String(attemptIndex)){
      opts = meta.opts; startedAt = meta.start;
    } else {
      opts = normalizeExamOptions_(null); /* client options are NEVER trusted for scoring */
      startedAt = data.startedAt ? String(data.startedAt) : nowISO_();
    }
    /* --- rebuild the deterministic set, fall back to text matching on bank drift --- */
    var bank = bank_();
    var sig = examOptsSignature_(opts);
    var seedKey = strSeed_(String(u.ID) + '|' + startedAt + '|' + sig);
    var rebuilt = buildExamSet_(bank, opts, seedKey);
    var byText = {};
    rebuilt.forEach(function(q){ byText[norm_(q.text)] = q; });
    var items = (data.qs || []).map(function(snap){
      var q = byText[norm_(snap.text)];
      if(!q){
        for(var k = 0; k < bank.length; k++){
          if(norm_(bank[k].text) === norm_(snap.text)){ q = bank[k]; break; }
        }
      }
      if(!q && snap.answer != null && opts.mode === 'practice') q = snap; /* ifb snapshot carries its own key */
      var chosen = (data.answers && data.answers[snap.id] != null) ? data.answers[snap.id] : -1;
      return {q:q, chosen:chosen};
    });
    /* --- score (server-side only) --- */
    var neg = opts.negMarking, correct = 0, wrong = 0, skipped = 0, score = 0;
    items.forEach(function(it){
      var r = scoreItem_(it.q, it.chosen, neg);
      if(r.state === 'correct'){ correct++; score += 1; }
      else if(r.state === 'wrong'){ wrong++; score += r.pts; }
      else skipped++;
    });
    score = Math.round(score * 100) / 100;
    var total = items.length;
    var submittedAt = nowISO_();
    var late = false;
    if(opts.timed && meta && String(meta.attemptIndex) === String(attemptIndex) && Number(meta.dur) > 0){
      late = (new Date(submittedAt) - new Date(meta.start)) > (Number(meta.dur) * 60 + 120) * 1000;
    }
    var secCounts = {};
    items.forEach(function(it){ if(it.q) secCounts[it.q.section] = (secCounts[it.q.section] || 0) + 1; });
    var secStr = Object.keys(secCounts).map(function(s){ return s + ':' + secCounts[s]; }).join('|');
    if(opts.mode === 'practice') secStr = 'PRACTICE|' + secStr;
    var attemptId = 'a-' + uid_();
    appendObj_('Attempts', {ID:attemptId, AttemptIndex:String(attemptIndex), UserId:String(u.ID),
      StartedAt:startedAt, SubmittedAt:submittedAt, DurMin:Number((meta && String(meta.attemptIndex) === String(attemptIndex)) ? meta.dur : (data.dur || 0)),
      Deadline:(meta && String(meta.attemptIndex) === String(attemptIndex) && opts.timed) ? new Date(new Date(meta.start).getTime() + Number(meta.dur) * 60000).toISOString() : '',
      Section:secStr, Mode:opts.mode, NegMarking:neg ? 'true' : 'false', Score:score, Total:total,
      Correct:correct, Wrong:wrong, Skipped:skipped,
      Accuracy: total ? Math.round(correct / total * 1000) / 10 : 0,
      AutoSubmitted:data.autoSubmitted ? 'true' : 'false', Late:late ? 'true' : 'false'});
    items.forEach(function(it, idx){
      if(!it.q) return;
      appendObj_('Responses', {ID:attemptId + '-r' + idx, AttemptId:attemptId, UserId:String(u.ID),
        QId:String(it.q.id || ''), QuestionText:String(it.q.text),
        Chosen:(it.chosen == null ? -1 : parseInt(it.chosen, 10)),
        IsCorrect:(it.chosen != null && parseInt(it.chosen, 10) >= 0 && parseInt(it.chosen, 10) === parseInt(it.q.answer, 10)) ? 'true' : 'false',
        Section:String(it.q.section), Topic:String(it.q.topic || '')});
    });
    if(meta && String(meta.attemptIndex) === String(attemptIndex)){
      props.deleteProperty(EXAM_META_KEY_ + u.ID);
    }
    emailResult_(u, {score:score, total:total, correct:correct, wrong:wrong, skipped:skipped,
                     accuracy: total ? Math.round(correct / total * 1000) / 10 : 0,
                     mode:opts.mode, negMarking:neg, id:attemptId});
    return {id:attemptId, score:score, total:total, correct:correct, wrong:wrong, skipped:skipped,
            accuracy: total ? Math.round(correct / total * 1000) / 10 : 0,
            section:secStr, mode:opts.mode, negMarking:neg,
            autoSubmitted:!!data.autoSubmitted, late:late, duplicate:false};
  } finally {
    lock.releaseLock();
  }
}

function getAttemptReview(userId, token, attemptId){
  var u = requireSession_(userId, token);
  var rows = readTab_('Attempts');
  var a = null;
  for(var i = 0; i < rows.length; i++){
    if(String(rows[i].ID) === String(attemptId)){ a = rows[i]; break; }
  }
  if(!a) throw err_('Attempt not found.');
  var teacherView = String(a.UserId) !== String(u.ID) && String(u.Role) === 'teacher';
  if(String(a.UserId) !== String(u.ID) && String(u.Role) !== 'teacher') throw err_('Not allowed.', 'FORBIDDEN');
  /* teacher reports carry the student identity for the print stamp */
  var student = null;
  if(teacherView){
    var su = getUserById_(a.UserId);
    if(su) student = {id:String(su.ID), name:String(su.Name), email:String(su.Email)};
  }
  var bank = bank_();
  var byText = {};
  bank.forEach(function(q){ byText[norm_(q.text)] = q; });
  var resps = readTab_('Responses').filter(function(r){ return String(r.AttemptId) === String(attemptId); });
  var items = resps.map(function(r){
    var q = byText[norm_(r.QuestionText)];
    return {id:String(r.QId), text:String(r.QuestionText),
            opts:q ? [String(q.opts[0]),String(q.opts[1]),String(q.opts[2]),String(q.opts[3])] : ['—','—','—','—'],
            answer:q ? parseInt(q.answer, 10) : -1,
            chosen:parseInt(r.Chosen, 10), section:String(r.Section), topic:String(r.Topic || ''),
            img:q ? String(q.img || '') : '',
            explanation:q ? String(q.explanation || '') : '(This question has been removed or edited since the attempt.)'};
  });
  return {id:String(a.ID), score:Number(a.Score), total:Number(a.Total), correct:Number(a.Correct),
          wrong:Number(a.Wrong), skipped:Number(a.Skipped), accuracy:Number(a.Accuracy),
          section:String(a.Section), mode:String(a.Mode), negMarking:String(a.NegMarking) === 'true',
          submittedAt:String(a.SubmittedAt), autoSubmitted:String(a.AutoSubmitted) === 'true',
          late:String(a.Late) === 'true', student:student, items:items};
}

